generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform Models ─────────────────────────────────────────────────────────

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  users                    User[]
  roles                    Role[]
  exchangeRates            ExchangeRate[]
  workflowDefinitions      WorkflowDefinition[]
  memberships              OrganizationMembership[]
  projects                 Project[]
  clients                  Client[]
  workflowPolicies         WorkflowRequirementPolicy[]

  @@map("organizations")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  status            UserStatus @default(ACTIVE)
  organizationId    String     @map("organization_id")
  preferredLanguage Language   @default(EN) @map("preferred_language")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  organization    Organization             @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  memberships     OrganizationMembership[]
  projectMembers  ProjectMember[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization               @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  membershipRoles OrganizationMembershipRole[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  action      String
  resource    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id            String    @id @default(cuid())
  jti           String    @unique @map("jti")
  tokenFamilyId String    @map("token_family_id")
  userId        String    @map("user_id")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  deviceHint    String?   @map("device_hint")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamilyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  orgId      String   @map("org_id")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ─── Multi-Currency ───────────────────────────────────────────────────────────

model ExchangeRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fromCurrency   String   @map("from_currency") @db.VarChar(3)
  toCurrency     String   @map("to_currency") @db.VarChar(3)
  rate           Decimal  @db.Decimal(18, 6)
  validFrom      DateTime @map("valid_from") @db.Date
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, fromCurrency, toCurrency, validFrom])
  @@map("exchange_rates")
}

// ─── DOA / Workflow Engine ────────────────────────────────────────────────────

model WorkflowDefinition {
  id                      String                   @id @default(cuid())
  organizationId          String                   @map("organization_id")
  transactionType         WorkflowTransactionType? @map("transaction_type")
  name                    String
  nameAr                  String                   @map("name_ar")
  isActive                Boolean                  @default(false) @map("is_active")
  requiresCeoConfirmation Boolean                  @default(false) @map("requires_ceo_confirmation")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  organization     Organization             @relation(fields: [organizationId], references: [id])
  conditions       WorkflowCondition[]
  steps            WorkflowStep[]
  instances        ApprovalInstance[]
  triggerBindings  WorkflowTriggerBinding[]

  @@index([organizationId, transactionType])
  @@map("workflow_definitions")
}

model WorkflowCondition {
  id           String  @id @default(cuid())
  definitionId String  @map("definition_id")
  field        String
  operator     String
  value        String
  currencyCode String? @map("currency_code") @db.VarChar(3)

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("workflow_conditions")
}

model WorkflowStep {
  id                 String   @id @default(cuid())
  definitionId       String   @map("definition_id")
  stepOrder          Int      @map("step_order")
  groupOrder         Int?     @map("group_order")
  roleRequired       String   @map("role_required")
  isOptional         Boolean  @default(false) @map("is_optional")
  escalateAfterHours Int?     @map("escalate_after_hours")
  notifyRoles        String[] @map("notify_roles")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId, stepOrder])
  @@map("workflow_steps")
}

model ApprovalInstance {
  id                   String                   @id @default(cuid())
  workflowDefinitionId String                   @map("workflow_definition_id")
  transactionType      WorkflowTransactionType? @map("transaction_type")
  transactionId        String                   @map("transaction_id")
  status               ApprovalStatus          @default(PENDING)
  currentStepOrder     Int                     @default(1) @map("current_step_order")
  initiatedBy          String                  @map("initiated_by")
  initiatedAt          DateTime                @default(now()) @map("initiated_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  actions    ApprovalAction[]

  @@index([transactionId, transactionType])
  @@index([status])
  @@map("approval_instances")
}

model ApprovalAction {
  id         String             @id @default(cuid())
  instanceId String             @map("instance_id")
  stepOrder  Int                @map("step_order")
  action     ApprovalActionType
  actorId    String             @map("actor_id")
  actedAt    DateTime           @default(now()) @map("acted_at")
  notes      String?

  instance ApprovalInstance @relation(fields: [instanceId], references: [id])

  @@index([instanceId])
  @@map("approval_actions")
}

// ─── Membership ───────────────────────────────────────────────────────────────

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  status         MembershipStatus @default(ACTIVE)
  isDefault      Boolean          @default(false) @map("is_default")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  removedAt      DateTime?        @map("removed_at")
  removedBy      String?          @map("removed_by")

  organization Organization               @relation(fields: [organizationId], references: [id])
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        OrganizationMembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_memberships")
}

model OrganizationMembershipRole {
  id           String    @id @default(cuid())
  membershipId String    @map("membership_id")
  roleId       String    @map("role_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedBy   String    @map("assigned_by")
  removedAt    DateTime? @map("removed_at")

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@map("organization_membership_roles")
}

// ─── Client Aggregate ────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  code            String       @map("code") @db.VarChar(30)
  name            String
  nameAr          String?      @map("name_ar")
  taxNumber       String?      @map("tax_number")
  defaultCurrency String?      @map("default_currency") @db.VarChar(3)
  status          ClientStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  contacts     ClientContact[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("clients")
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String  @map("client_id")
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

// ─── Workflow Requirement Policy ──────────────────────────────────────────────

model WorkflowRequirementPolicy {
  id             String              @id @default(cuid())
  organizationId String?             @map("organization_id")
  entityType     String              @map("entity_type")
  fromState      String?             @map("from_state")
  toState        String              @map("to_state")
  requirement    WorkflowRequirement @default(OPTIONAL)

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([entityType, toState])
  @@map("workflow_requirement_policies")
}

// ─── Workflow Trigger Bindings ────────────────────────────────────────────────

model WorkflowTriggerBinding {
  id                   String                   @id @default(cuid())
  organizationId       String?                  @map("organization_id")
  triggerKind          WorkflowTriggerKind      @map("trigger_kind")
  entityType           String                   @map("entity_type")
  transactionType      WorkflowTransactionType? @map("transaction_type")
  fromState            String?                  @map("from_state")
  toState              String?                  @map("to_state")
  workflowDefinitionId String                   @map("workflow_definition_id")
  priority             Int                      @default(0)
  isActive             Boolean                  @default(false) @map("is_active")
  createdAt            DateTime                 @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])

  @@index([organizationId, triggerKind, entityType, toState])
  @@map("workflow_trigger_bindings")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum Language {
  EN
  AR
}

enum WorkflowTransactionType {
  MATERIAL_REQUEST
  PURCHASE_ORDER
  SUPPLIER_PAYMENT
  STOCK_TRANSFER
  MATERIAL_ISSUE
  SUBCONTRACT_CERTIFICATE
  IPC
  VARIATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  DELEGATE
  ESCALATE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WorkflowTriggerKind {
  DOCUMENT
  STATE_TRANSITION
}

// ─── Construction Domain ──────────────────────────────────────────────────────

model Project {
  id                 String             @id @default(cuid())
  organizationId     String             @map("organization_id")
  code               String             @map("code") @db.VarChar(30)
  name               String
  nameAr             String?            @map("name_ar")
  description        String?
  status             ProjectStatus      @default(DRAFT)
  commercialModel    CommercialModel    @default(CLIENT_CONTRACT) @map("commercial_model")
  participationModel ParticipationModel @default(SOLE) @map("participation_model")
  contractValue      Decimal?           @map("contract_value") @db.Decimal(18, 2)
  currency           String?            @db.VarChar(3)
  clientName         String?            @map("client_name")
  startDate          DateTime?          @map("start_date") @db.Date
  expectedEndDate    DateTime?          @map("expected_end_date") @db.Date
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  members      ProjectMember[]
  suspensions  ProjectSuspension[]
  boq          Boq?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectSuspension {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  reason      String
  suspendedAt DateTime  @default(now()) @map("suspended_at")
  suspendedBy String    @map("suspended_by")
  resumedAt   DateTime? @map("resumed_at")
  resumedBy   String?   @map("resumed_by")

  project Project @relation(fields: [projectId], references: [id])

  // NOTE: A partial unique index enforcing one active suspension per project is added
  // via raw SQL in the migration (WHERE resumed_at IS NULL) — Prisma cannot express this.
  @@index([projectId])
  @@map("project_suspensions")
}

model ProjectMember {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  userId    String    @map("user_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  joinedBy  String    @map("joined_by")
  removedAt DateTime? @map("removed_at")
  removedBy String?   @map("removed_by")

  project Project             @relation(fields: [projectId], references: [id])
  user    User                @relation(fields: [userId], references: [id])
  roles   ProjectMemberRole[]

  // NOTE: Partial unique index (one active member per project+user) added via raw SQL in migration.
  @@index([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectMemberRole {
  id         String      @id @default(cuid())
  memberId   String      @map("member_id")
  role       ProjectRole
  assignedAt DateTime    @default(now()) @map("assigned_at")
  assignedBy String      @map("assigned_by")
  removedAt  DateTime?   @map("removed_at")

  member ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("project_member_roles")
}

// ─── BOQ ─────────────────────────────────────────────────────────────────────

model Boq {
  id                        String  @id @default(cuid())
  projectId                 String  @unique @map("project_id")
  organizationId            String  @map("organization_id")
  // Three logical pointers — maintained by application layer, no Prisma relations
  // to avoid circular dependency complexity. FK constraints added via raw SQL in migration.
  originalBaselineVersionId String? @map("original_baseline_version_id")
  currentApprovedVersionId  String? @map("current_approved_version_id")
  currentDraftVersionId     String? @map("current_draft_version_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id])
  versions BoqVersion[]

  @@index([organizationId])
  @@map("boqs")
}

model BoqVersion {
  id            String           @id @default(cuid())
  boqId         String           @map("boq_id")
  versionNumber Int              @map("version_number")
  status        BoqVersionStatus @default(DRAFT)
  notes         String?
  baselinedAt   DateTime?        @map("baselined_at")
  baselinedBy   String?          @map("baselined_by")
  createdBy     String           @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  boq   Boq       @relation(fields: [boqId], references: [id])
  nodes BoqNode[]

  @@unique([boqId, versionNumber])
  @@index([boqId, status])
  @@map("boq_versions")
}

model BoqNode {
  id                String          @id @default(cuid())
  boqId             String          @map("boq_id")
  versionId         String          @map("version_id")
  parentId          String?         @map("parent_id")
  // Materialized path: "rootId/childId/grandchildId" — enables efficient subtree queries.
  path              String          @map("path")
  depth             Int             @default(0)
  sortOrder         Int             @default(0) @map("sort_order")
  code              String          @db.VarChar(50)
  description       String
  descriptionAr     String?         @map("description_ar")
  measurementMethod MeasurementMethod @default(QUANTITY) @map("measurement_method")
  pricingBasis      PricingBasis    @default(UNIT_RATE) @map("pricing_basis")
  unit              String?         @db.VarChar(20)
  quantity          Decimal?        @db.Decimal(18, 3)
  unitRate          Decimal?        @map("unit_rate") @db.Decimal(18, 2)
  currency          String?         @db.VarChar(3)
  totalAmount       Decimal?        @map("total_amount") @db.Decimal(18, 2)
  isLeaf            Boolean         @default(false) @map("is_leaf")
  // Tracks which node in the previous version this was copied from.
  originNodeId      String?         @map("origin_node_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  version  BoqVersion @relation(fields: [versionId], references: [id])
  parent   BoqNode?   @relation("BoqNodeChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children BoqNode[]  @relation("BoqNodeChildren")

  @@index([versionId, parentId])
  @@index([versionId, path])
  @@map("boq_nodes")
}

enum BoqVersionStatus {
  DRAFT
  BASELINED
  SUPERSEDED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  APPROVED
  MOBILIZING
  ACTIVE
  PRACTICAL_COMPLETION
  CLOSEOUT
  CLOSED
  CANCELLED
}

enum CommercialModel {
  CLIENT_CONTRACT
  INTERNAL_CAPITAL
}

enum ParticipationModel {
  SOLE
  JOINT_VENTURE
}

enum MeasurementMethod {
  QUANTITY
  PERCENTAGE
  MILESTONE
}

enum PricingBasis {
  UNIT_RATE
  LUMP_SUM
}

enum WorkflowRequirement {
  REQUIRED
  OPTIONAL
  NONE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ProjectRole {
  PROJECT_MANAGER
  QUANTITY_SURVEYOR
  SITE_ENGINEER
  COMMERCIAL_MANAGER
  FINANCE_REVIEWER
  VIEWER
}
