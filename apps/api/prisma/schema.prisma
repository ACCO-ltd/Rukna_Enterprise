generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform Models ─────────────────────────────────────────────────────────

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  users                    User[]
  roles                    Role[]
  exchangeRates            ExchangeRate[]
  workflowDefinitions      WorkflowDefinition[]
  workflowPolicyVersions   WorkflowPolicyVersion[]
  segregationOfDutiesRules SegregationOfDutiesRule[]
  auditOutboxEvents        AuditOutboxEvent[]
  memberships              OrganizationMembership[]
  projects                 Project[]
  projectCodeSequences     ProjectCodeSequence[]
  clients                  Client[]
  clientCodeSequence       ClientCodeSequence?
  contracts                Contract[]
  applications             InterimPaymentApplication[]
  certificates             InterimPaymentCertificate[]
  receipts                 PaymentReceipt[]
  workflowPolicies         WorkflowRequirementPolicy[]
  // Sprint 4 — Accounting
  suppliers                Supplier[]
  departments              Department[]
  accounts                 Account[]
  fiscalYears              FiscalYear[]
  taxCodes                 TaxCode[]
  treasuryGroups           TreasuryGroup[]
  postingProfiles          PostingProfile[]
  clientInvoices           ClientInvoice[]
  supplierBills            SupplierBill[]
  supplierPayments         SupplierPayment[]
  journalEntries           JournalEntry[]
  // Sprint 5 — Procurement
  unitsOfMeasure           UnitOfMeasure[]
  materialCategories       MaterialCategory[]
  spendCategories          SpendCategory[]
  materials                Material[]
  materialRequests         MaterialRequest[]
  purchaseOrders           PurchaseOrder[]
  poLineAllocations        PurchaseOrderLineRequestAllocation[]
  grnNotes                 GoodsReceiptNote[]
  grnLineAllocations       GoodsReceiptLineAllocation[]
  matchingPolicies         MatchingTolerancePolicy[]
  overReceiptPolicies      OverReceiptPolicy[]
  commitmentEntries        CommitmentLedgerEntry[]

  @@map("organizations")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  status            UserStatus @default(ACTIVE)
  organizationId    String     @map("organization_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  organization   Organization             @relation(fields: [organizationId], references: [id])
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  memberships    OrganizationMembership[]
  projectMembers ProjectMember[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization                 @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  membershipRoles OrganizationMembershipRole[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  action      String
  resource    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id            String    @id @default(cuid())
  jti           String    @unique @map("jti")
  tokenFamilyId String    @map("token_family_id")
  userId        String    @map("user_id")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  deviceHint    String?   @map("device_hint")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamilyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  orgId              String   @map("org_id")
  action             String
  resource           String
  resourceId         String   @map("resource_id")
  before             Json?
  after              Json?
  actorRoleContext   Json?    @map("actor_role_context")
  reason             String?
  sourceCommand      String?  @map("source_command")
  approvalInstanceId String?  @map("approval_instance_id")
  correlationId      String?  @map("correlation_id")
  requestId          String?  @map("request_id")
  ipAddress          String?  @map("ip_address")
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// Delivery state is mutable; the referenced audit event and its payload are immutable.
// A business mutation creates AuditLog + AuditOutboxEvent in the same tenant transaction.
model AuditOutboxEvent {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  auditLogId      String    @unique @map("audit_log_id")
  aggregateType   String    @map("aggregate_type")
  aggregateId     String    @map("aggregate_id")
  eventType       String    @map("event_type")
  idempotencyKey  String    @unique @map("idempotency_key")
  payload         Json
  occurredAt      DateTime  @default(now()) @map("occurred_at")
  publishedAt     DateTime? @map("published_at")
  publishAttempts Int       @default(0) @map("publish_attempts")
  lastError       String?   @map("last_error")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, publishedAt, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("audit_outbox_events")
}

// ─── Multi-Currency ───────────────────────────────────────────────────────────

model ExchangeRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fromCurrency   String   @map("from_currency") @db.VarChar(3)
  toCurrency     String   @map("to_currency") @db.VarChar(3)
  rate           Decimal  @db.Decimal(18, 6)
  validFrom      DateTime @map("valid_from") @db.Date
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, fromCurrency, toCurrency, validFrom])
  @@map("exchange_rates")
}

// ─── DOA / Workflow Engine ────────────────────────────────────────────────────

model WorkflowDefinition {
  id                      String                   @id @default(cuid())
  organizationId          String                   @map("organization_id")
  transactionType         WorkflowTransactionType? @map("transaction_type")
  name                    String
  isActive                Boolean                  @default(false) @map("is_active")
  requiresCeoConfirmation Boolean                  @default(false) @map("requires_ceo_confirmation")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  organization    Organization             @relation(fields: [organizationId], references: [id])
  conditions      WorkflowCondition[]
  steps           WorkflowStep[]
  instances       ApprovalInstance[]
  triggerBindings WorkflowTriggerBinding[]

  @@index([organizationId, transactionType])
  @@map("workflow_definitions")
}

model WorkflowCondition {
  id           String  @id @default(cuid())
  definitionId String  @map("definition_id")
  field        String
  operator     String
  value        String
  currencyCode String? @map("currency_code") @db.VarChar(3)

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("workflow_conditions")
}

model WorkflowStep {
  id                 String   @id @default(cuid())
  definitionId       String   @map("definition_id")
  stepOrder          Int      @map("step_order")
  groupOrder         Int?     @map("group_order")
  roleRequired       String   @map("role_required")
  isOptional         Boolean  @default(false) @map("is_optional")
  escalateAfterHours Int?     @map("escalate_after_hours")
  notifyRoles        String[] @map("notify_roles")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId, stepOrder])
  @@map("workflow_steps")
}

model ApprovalInstance {
  id                    String                   @id @default(cuid())
  workflowDefinitionId  String                   @map("workflow_definition_id")
  transactionType       WorkflowTransactionType? @map("transaction_type")
  transactionId         String                   @map("transaction_id")
  status                ApprovalStatus           @default(PENDING)
  currentStepOrder      Int                      @default(1) @map("current_step_order")
  initiatedBy           String                   @map("initiated_by")
  initiatedAt           DateTime                 @default(now()) @map("initiated_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  // Sprint 5: immutable condition snapshot — why this policy was selected (ADR-007, Rule DOA-001)
  evaluatedAmount       Decimal?                 @map("evaluated_amount") @db.Decimal(18, 2)
  reportingCurrencyCode String?                  @map("reporting_currency_code") @db.VarChar(3)
  matchedPolicyId       String?                  @map("matched_policy_id")
  matchedPolicyVersion  Int?                     @map("matched_policy_version")
  conditionSnapshot     Json?                    @map("condition_snapshot")

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  actions    ApprovalAction[]

  @@index([transactionId, transactionType])
  @@index([status])
  @@map("approval_instances")
}

model ApprovalAction {
  id         String             @id @default(cuid())
  instanceId String             @map("instance_id")
  stepOrder  Int                @map("step_order")
  action     ApprovalActionType
  actorId    String             @map("actor_id")
  actedAt    DateTime           @default(now()) @map("acted_at")
  notes      String?

  instance ApprovalInstance @relation(fields: [instanceId], references: [id])

  @@index([instanceId])
  @@map("approval_actions")
}

// ─── Membership ───────────────────────────────────────────────────────────────

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  status         MembershipStatus @default(ACTIVE)
  isDefault      Boolean          @default(false) @map("is_default")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  removedAt      DateTime?        @map("removed_at")
  removedBy      String?          @map("removed_by")

  organization Organization                 @relation(fields: [organizationId], references: [id])
  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        OrganizationMembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_memberships")
}

model OrganizationMembershipRole {
  id           String    @id @default(cuid())
  membershipId String    @map("membership_id")
  roleId       String    @map("role_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedBy   String    @map("assigned_by")
  removedAt    DateTime? @map("removed_at")

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@map("organization_membership_roles")
}

// ─── Client Aggregate ────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  code            String       @map("code") @db.VarChar(30)
  name            String
  type            ClientType   @default(COMPANY)
  taxNumber       String?      @map("tax_number")
  defaultCurrency String?      @map("default_currency") @db.VarChar(3)
  address         String?
  notes           String?
  status          ClientStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id])
  contacts       ClientContact[]
  receipts       PaymentReceipt[]
  contracts      Contract[]
  clientInvoices ClientInvoice[]
  projects       Project[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("clients")
}

// A policy version is the effective-dated governance envelope. A version remains
// inactive until its formal effective date and explicit activation.
model WorkflowPolicyVersion {
  id                String               @id @default(cuid())
  organizationId    String               @map("organization_id")
  policyKey         String               @map("policy_key")
  version           Int
  status            WorkflowPolicyStatus @default(DRAFT)
  effectiveFrom     DateTime?            @map("effective_from")
  effectiveTo       DateTime?            @map("effective_to")
  reportingCurrency String               @map("reporting_currency") @db.VarChar(3)
  amountBasis       WorkflowAmountBasis  @default(UNSPECIFIED) @map("amount_basis")
  notes             String?
  approvedAt        DateTime?            @map("approved_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organization           Organization              @relation(fields: [organizationId], references: [id])
  rules                  WorkflowPolicyRule[]
  segregationDutiesRules SegregationOfDutiesRule[]

  @@unique([organizationId, policyKey, version])
  @@index([organizationId, policyKey, status, effectiveFrom])
  @@map("workflow_policy_versions")
}

// Rules are data, not service conditionals. Configuration preserves pending
// decisions without activating an incomplete approval route.
model WorkflowPolicyRule {
  id                      String                   @id @default(cuid())
  workflowPolicyVersionId String                   @map("workflow_policy_version_id")
  ruleKey                 String                   @map("rule_key")
  transactionType         WorkflowTransactionType? @map("transaction_type")
  entityType              String?                  @map("entity_type")
  status                  WorkflowPolicyRuleStatus @default(PENDING)
  priority                Int                      @default(0)
  configuration           Json
  createdAt               DateTime                 @default(now()) @map("created_at")

  policyVersion WorkflowPolicyVersion @relation(fields: [workflowPolicyVersionId], references: [id], onDelete: Cascade)

  @@unique([workflowPolicyVersionId, ruleKey])
  @@index([transactionType, status])
  @@map("workflow_policy_rules")
}

model SegregationOfDutiesRule {
  id                      String   @id @default(cuid())
  organizationId          String   @map("organization_id")
  workflowPolicyVersionId String   @map("workflow_policy_version_id")
  code                    String
  description             String
  isActive                Boolean  @default(false) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization  Organization          @relation(fields: [organizationId], references: [id])
  policyVersion WorkflowPolicyVersion @relation(fields: [workflowPolicyVersionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("segregation_of_duties_rules")
}

model ClientCodeSequence {
  organizationId String   @id @map("organization_id")
  nextValue      Int      @default(1) @map("next_value")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("client_code_sequences")
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String  @map("client_id")
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

// ─── Workflow Requirement Policy ──────────────────────────────────────────────

model WorkflowRequirementPolicy {
  id              String                   @id @default(cuid())
  organizationId  String?                  @map("organization_id")
  entityType      String                   @map("entity_type")
  fromState       String?                  @map("from_state")
  toState         String                   @map("to_state")
  requirement     WorkflowRequirement      @default(OPTIONAL)
  priority        Int                      @default(0)
  // Sprint 5: conditional routing — threshold-based DOA (ADR-007, Rule DOA-001 to DOA-003)
  // Multiple rows with the same entityType+toState but different conditionField are AND-combined.
  conditionField  PolicyConditionField?    @map("condition_field")
  conditionOp     PolicyConditionOperator? @map("condition_op")
  conditionValue  String?                  @map("condition_value")
  conditionValue2 String?                  @map("condition_value2")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([entityType, toState])
  @@map("workflow_requirement_policies")
}

// ─── Workflow Trigger Bindings ────────────────────────────────────────────────

model WorkflowTriggerBinding {
  id                   String                   @id @default(cuid())
  organizationId       String?                  @map("organization_id")
  triggerKind          WorkflowTriggerKind      @map("trigger_kind")
  entityType           String                   @map("entity_type")
  transactionType      WorkflowTransactionType? @map("transaction_type")
  fromState            String?                  @map("from_state")
  toState              String?                  @map("to_state")
  workflowDefinitionId String                   @map("workflow_definition_id")
  priority             Int                      @default(0)
  isActive             Boolean                  @default(false) @map("is_active")
  createdAt            DateTime                 @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])

  @@index([organizationId, triggerKind, entityType, toState])
  @@map("workflow_trigger_bindings")
}

// ─── Construction Domain ──────────────────────────────────────────────────────

model Project {
  id                 String             @id @default(cuid())
  organizationId     String             @map("organization_id")
  code               String             @map("code") @db.VarChar(30)
  name               String
  description        String?
  status             ProjectStatus      @default(DRAFT)
  commercialModel    CommercialModel    @default(CLIENT_CONTRACT) @map("commercial_model")
  participationModel ParticipationModel @default(SOLE) @map("participation_model")
  contractValue      Decimal?           @map("contract_value") @db.Decimal(18, 2)
  currency           String?            @db.VarChar(3)
  clientName         String?            @map("client_name")
  clientId           String?            @map("client_id")
  location           String?
  startDate          DateTime?          @map("start_date") @db.Date
  expectedEndDate    DateTime?          @map("expected_end_date") @db.Date
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id])
  members              ProjectMember[]
  suspensions          ProjectSuspension[]
  boq                  Boq?
  contracts            Contract[]
  documents            ProjectDocument[]
  dailyProgressReports DailyProgressReport[]
  workPackages         WorkPackage[]
  programmeMilestones  ProgrammeMilestone[]
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@map("projects")
}

// ADR-014 / Documents tab: a standalone project document (permit, drawing, licence...) linking a
// PlatformFile to a project with a human title + category. Distinct from the per-entity *Attachment
// tables (which the Documents tab also surfaces as "linked documents").
model ProjectDocument {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  projectId      String           @map("project_id")
  platformFileId String           @map("platform_file_id")
  category       DocumentCategory
  title          String
  uploadedBy     String           @map("uploaded_by")
  createdAt      DateTime         @default(now()) @map("created_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platformFile PlatformFile @relation(fields: [platformFileId], references: [id])

  @@index([projectId])
  @@map("project_documents")
}

enum DocumentCategory {
  PERMIT
  LICENSE
  DRAWING
  CONTRACT
  CERTIFICATE
  INSURANCE
  GUARANTEE
  CORRESPONDENCE
  PHOTO
  OTHER
}

// ADR-021 Progress MVP: the daily site record. An evidence container (weather, labour, narrative,
// delay reason, photo/measurement attachments). Progress becomes verified only when APPROVED
// (CONST-PROG-008); once approved it is immutable outside a controlled reopen (CONST-PROG-010).
model DailyProgressReport {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id")
  reportDate     DateTime  @map("report_date") @db.Date
  status         DprStatus @default(DRAFT)
  weather        String?
  labourCount    Int?      @map("labour_count")
  equipmentNote  String?   @map("equipment_note")
  narrative      String?
  // CONST-PROG-012: raw material for delay analysis, captured now; the formal DelayEvent is deferred.
  delayReason    String?   @map("delay_reason")
  preparedBy     String    @map("prepared_by")
  submittedBy    String?   @map("submitted_by")
  submittedAt    DateTime? @map("submitted_at")
  approvedBy     String?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  returnReason   String?   @map("return_reason")
  createdAt      DateTime  @default(now()) @map("created_at")

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements ProgressMeasurement[]
  attachments  DprAttachment[]

  @@index([projectId, reportDate])
  @@map("daily_progress_reports")
}

// ADR-021: a measured quantity inside a DPR, against a BOQ leaf. Verified when its DPR is APPROVED.
// Cumulative verified quantity per BOQ node cannot exceed the node's measurable quantity (CONST-PROG-002/009).
model ProgressMeasurement {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  dprId          String  @map("dpr_id")
  boqNodeId      String  @map("boq_node_id")
  quantity       Decimal @db.Decimal(18, 3)
  notes          String?
  createdBy      String  @map("created_by")

  dpr     DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  boqNode BoqNode             @relation(fields: [boqNodeId], references: [id])

  @@index([dprId])
  @@index([boqNodeId])
  @@map("progress_measurements")
}

// ADR-021/014: evidence attached to a DPR (photos, measurement sheets), stored via PlatformFile.
model DprAttachment {
  id             String @id @default(cuid())
  dprId          String @map("dpr_id")
  platformFileId String @map("platform_file_id")
  createdBy      String @map("created_by")

  dpr          DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  platformFile PlatformFile        @relation(fields: [platformFileId], references: [id])

  @@index([dprId])
  @@map("dpr_attachments")
}

enum DprStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

// ADR-021 CONST-PROG-005: the always-explicit control seam between BOQ scope and site execution.
// A WorkPackage carries a responsible owner and a progressWeight; the project's weights should total
// 1.0 (100%). Physical progress rolls up by these weights, never by BOQ money (CONST-PROG-007).
model WorkPackage {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  projectId        String   @map("project_id")
  code             String
  name             String
  responsibleOwner String?  @map("responsible_owner")
  progressWeight   Decimal  @default(0) @map("progress_weight") @db.Decimal(5, 4)
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqLinks WorkPackageBoqNode[]

  @@unique([projectId, code])
  @@index([projectId])
  @@map("work_packages")
}

// BOQ leaf → WorkPackage allocation. A leaf belongs to AT MOST ONE work package (unique on
// boqNodeId), so its verified progress is counted exactly once in the weighted roll-up — the
// anti-double-counting invariant (CONST-PROG-012). Splitting a leaf across packages would need a
// proportional fraction; deferred.
model WorkPackageBoqNode {
  id            String @id @default(cuid())
  workPackageId String @map("work_package_id")
  boqNodeId     String @map("boq_node_id")

  workPackage WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  boqNode     BoqNode     @relation(fields: [boqNodeId], references: [id])

  @@unique([boqNodeId])
  @@index([workPackageId])
  @@map("work_package_boq_nodes")
}

enum ProgrammeMilestoneStatus {
  PLANNED // a planned construction stage carrying a baseline date
  VERIFIED // the stage is confirmed complete (actual date recorded) — billing evidence (CONST-COM-011)
}

// ADR-021 phase 2: a programme delivery milestone — a named construction stage on the project's
// programme, with baseline / forecast / actual dates. An authorized member verifies it when the stage
// is complete; a MILESTONE payment installment may reference a VERIFIED milestone as its billing
// evidence (ADR-023 CONST-COM-011). Optionally links to a ContractMilestone; the two lifecycles stay
// separate.
model ProgrammeMilestone {
  id                  String                   @id @default(cuid())
  organizationId      String                   @map("organization_id")
  projectId           String                   @map("project_id")
  code                String
  name                String
  status              ProgrammeMilestoneStatus @default(PLANNED)
  baselineDate        DateTime                 @map("baseline_date") @db.Date
  forecastDate        DateTime?                @map("forecast_date") @db.Date
  actualDate          DateTime?                @map("actual_date") @db.Date
  sortOrder           Int                      @default(0) @map("sort_order")
  contractMilestoneId String?                  @map("contract_milestone_id")
  verifiedBy          String?                  @map("verified_by")
  verifiedAt          DateTime?                @map("verified_at")
  createdBy           String                   @map("created_by")
  createdAt           DateTime                 @default(now()) @map("created_at")

  project           Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractMilestone ContractMilestone?           @relation(fields: [contractMilestoneId], references: [id], onDelete: SetNull)
  installments      ContractPaymentInstallment[]

  @@unique([projectId, code])
  @@index([projectId])
  @@map("programme_milestones")
}

model ProjectCodeSequence {
  organizationId String   @map("organization_id")
  year           Int
  nextValue      Int      @default(1) @map("next_value")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, year])
  @@map("project_code_sequences")
}

model ProjectSuspension {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  reason      String
  suspendedAt DateTime  @default(now()) @map("suspended_at")
  suspendedBy String    @map("suspended_by")
  resumedAt   DateTime? @map("resumed_at")
  resumedBy   String?   @map("resumed_by")

  project Project @relation(fields: [projectId], references: [id])

  // NOTE: Partial unique index (one active suspension per project) enforced via raw SQL:
  // CREATE UNIQUE INDEX uidx_project_suspensions_active ON project_suspensions (project_id) WHERE resumed_at IS NULL;
  @@index([projectId])
  @@map("project_suspensions")
}

model ProjectMember {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  userId    String    @map("user_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  joinedBy  String    @map("joined_by")
  removedAt DateTime? @map("removed_at")
  removedBy String?   @map("removed_by")

  project Project             @relation(fields: [projectId], references: [id])
  user    User                @relation(fields: [userId], references: [id])
  roles   ProjectMemberRole[]

  // NOTE: Partial unique index (one active member per project+user) enforced via raw SQL:
  // CREATE UNIQUE INDEX uidx_project_members_active ON project_members (project_id, user_id) WHERE removed_at IS NULL;
  @@index([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectMemberRole {
  id         String      @id @default(cuid())
  memberId   String      @map("member_id")
  role       ProjectRole
  assignedAt DateTime    @default(now()) @map("assigned_at")
  assignedBy String      @map("assigned_by")
  removedAt  DateTime?   @map("removed_at")

  member ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("project_member_roles")
}

// ─── BOQ ─────────────────────────────────────────────────────────────────────

model Boq {
  id                        String   @id @default(cuid())
  projectId                 String   @unique @map("project_id")
  organizationId            String   @map("organization_id")
  // CONST-BOQ-013 — the BOQ's unit of account. Seeded from Project.currency at
  // initialization. Every node either carries this currency or none; the aggregate sums
  // amounts, so it cannot hold two.
  currency                  String   @default("USD") @db.VarChar(3)
  originalBaselineVersionId String?  @map("original_baseline_version_id")
  currentApprovedVersionId  String?  @map("current_approved_version_id")
  currentDraftVersionId     String?  @map("current_draft_version_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id])
  versions BoqVersion[]

  @@index([organizationId])
  @@map("boqs")
}

model BoqVersion {
  id                   String           @id @default(cuid())
  boqId                String           @map("boq_id")
  versionNumber        Int              @map("version_number")
  status               BoqVersionStatus @default(DRAFT)
  notes                String?
  // CONST-BOQ-018 attribution. ADR-004 specified derivedFromVersionId; it never shipped,
  // so a revision could not state which baseline it was copied from. Soft reference — no
  // FK, matching the version pointers on Boq.
  derivedFromVersionId String?          @map("derived_from_version_id")
  preparedBy           String?          @map("prepared_by")
  submittedBy          String?          @map("submitted_by")
  submittedAt          DateTime?        @map("submitted_at")
  baselinedAt          DateTime?        @map("baselined_at")
  baselinedBy          String?          @map("baselined_by")
  createdBy            String           @map("created_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  boq   Boq       @relation(fields: [boqId], references: [id])
  nodes BoqNode[]

  @@unique([boqId, versionNumber])
  @@index([boqId, status])
  @@map("boq_versions")
}

model BoqNode {
  id                  String            @id @default(cuid())
  boqId               String            @map("boq_id")
  versionId           String            @map("version_id")
  parentId            String?           @map("parent_id")
  path                String            @map("path")
  depth               Int               @default(0)
  sortOrder           Int               @default(0) @map("sort_order")
  code                String            @db.VarChar(50)
  description         String
  measurementMethod   MeasurementMethod @default(QUANTITY) @map("measurement_method")
  pricingBasis        PricingBasis      @default(UNIT_RATE) @map("pricing_basis")
  unit                String?           @db.VarChar(20)
  quantity            Decimal?          @db.Decimal(18, 3)
  unitRate            Decimal?          @map("unit_rate") @db.Decimal(18, 2)
  currency            String?           @db.VarChar(3)
  totalAmount         Decimal?          @map("total_amount") @db.Decimal(18, 2)
  isLeaf              Boolean           @default(false) @map("is_leaf")
  originNodeId        String?           @map("origin_node_id")
  // Sprint 5: variation-readiness — BASELINE nodes are original scope; VARIATION nodes
  // come from a ChangeOrder (Sprint 6). sourceChangeOrderId is null until Sprint 6 adds ChangeOrder.
  sourceType          BoqSourceType     @default(BASELINE) @map("source_type")
  sourceChangeOrderId String?           @map("source_change_order_id")
  // CONST-BOQ-003 — a node referenced by a downstream record is deactivated, never deleted.
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  version              BoqVersion            @relation(fields: [versionId], references: [id])
  parent               BoqNode?              @relation("BoqNodeChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children             BoqNode[]             @relation("BoqNodeChildren")
  progressMeasurements ProgressMeasurement[]
  workPackageLinks     WorkPackageBoqNode[]

  // CONST-BOQ-015 — codes address lines in a contract; two nodes answering to "02.01.002"
  // makes every downstream reference ambiguous.
  @@unique([versionId, code])
  // CONST-BOQ-017 — dense, unique sibling order. Postgres treats NULLs as distinct, so this
  // constrains non-root siblings only; the migration adds a partial unique index covering
  // root nodes (parent_id IS NULL).
  @@unique([versionId, parentId, sortOrder])
  @@index([versionId, parentId])
  @@index([versionId, path])
  @@map("boq_nodes")
}

// ─── Contract Domain ──────────────────────────────────────────────────────────

model Contract {
  id                 String         @id @default(cuid())
  projectId          String         @map("project_id")
  organizationId     String         @map("organization_id")
  clientId           String         @map("client_id")
  boqVersionId       String         @map("boq_version_id")
  contractNumber     String         @map("contract_number") @db.VarChar(50)
  contractValue      Decimal        @map("contract_value") @db.Decimal(18, 2)
  currency           String         @db.VarChar(3)
  billingModel       BillingModel   @default(MEASURED_IPC) @map("billing_model")
  contractKind       ContractKind   @default(CLIENT_CONTRACT) @map("contract_kind")
  status             ContractStatus @default(DRAFT)
  clientNameSnapshot String?        @map("client_name_snapshot")
  clientTaxSnapshot  String?        @map("client_tax_snapshot")
  startDate          DateTime?      @map("start_date") @db.Date
  expectedEndDate    DateTime?      @map("expected_end_date") @db.Date
  createdBy          String         @map("created_by")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  project             Project                      @relation(fields: [projectId], references: [id])
  organization        Organization                 @relation(fields: [organizationId], references: [id])
  client              Client                       @relation(fields: [clientId], references: [id])
  retentionTerms      ContractRetentionTerms?
  advanceTerms        ContractAdvanceTerm[]
  guarantees          ContractGuarantee[]
  milestones          ContractMilestone[]
  attachments         ContractAttachment[]
  applications        InterimPaymentApplication[]
  paymentInstallments ContractPaymentInstallment[]

  @@unique([organizationId, contractNumber])
  @@index([projectId, status])
  @@index([clientId])
  @@map("contracts")
}

model ContractRetentionTerms {
  contractId          String    @id @map("contract_id")
  retentionRate       Decimal   @map("retention_rate") @db.Decimal(5, 4)
  retentionCap        Decimal   @map("retention_cap") @db.Decimal(5, 4)
  retentionSplitOnPC  Decimal   @map("retention_split_on_pc") @db.Decimal(5, 4)
  retentionReleasedAt DateTime? @map("retention_released_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_retention_terms")
}

model ContractAdvanceTerm {
  id           String      @id @default(cuid())
  contractId   String      @map("contract_id")
  advanceType  AdvanceType @map("advance_type")
  description  String?
  amount       Decimal?    @db.Decimal(18, 2)
  percentage   Decimal?    @db.Decimal(5, 4)
  recoveryRate Decimal     @map("recovery_rate") @db.Decimal(5, 4)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_advance_terms")
}

// ADR-023: the negotiated payment schedule for a PAYMENT_SCHEDULE (MILESTONE) contract.
// The installments ARE the plan (no separate 1:1 plan header). Only the percentage is stored;
// the amount is derived (percentage × contract value), so there is no monetary field to pair
// with a currency and no drift between a stored amount and the contract value.
// Invariant: Σ(percentage) = 1.0000 across a contract's installments (validated in the service).
// ACCO V1: no retention, no advance recovery (ADR-023 CONST-COM-013/014).
model ContractPaymentInstallment {
  id             String         @id @default(cuid())
  contractId     String         @map("contract_id")
  sortOrder      Int            @default(0) @map("sort_order")
  name           String
  percentage     Decimal        @db.Decimal(5, 4)
  triggerType    PaymentTrigger @map("trigger_type")
  // TIME_BASED triggers: due N days after commencement, or on an explicit date.
  dueOffsetDays  Int?           @map("due_offset_days")
  dueDate        DateTime?      @map("due_date") @db.Date
  // MILESTONE triggers: a free-text label (interim/fallback) plus an optional link to a verified
  // programme milestone (ADR-021), which is the billing evidence when present (CONST-COM-011).
  milestoneLabel      String? @map("milestone_label")
  programmeMilestoneId String? @map("programme_milestone_id")

  contract           Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientInvoice      ClientInvoice? // ADR-023: the invoice generated from this installment, if any
  programmeMilestone ProgrammeMilestone? @relation(fields: [programmeMilestoneId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@map("contract_payment_installments")
}

model ContractGuarantee {
  id            String          @id @default(cuid())
  contractId    String          @map("contract_id")
  // The instrument's own reference — "BG-003", "APG-002". How a guarantee is identified in a
  // conversation with the issuing bank and on the document itself. Nullable: guarantees loaded
  // before this column existed have none, and inventing one would be worse than leaving it blank.
  reference     String?         @db.VarChar(50)
  guaranteeType String          @map("guarantee_type")
  amount        Decimal         @db.Decimal(18, 2)
  currency      String          @db.VarChar(3)
  issuer        String
  beneficiary   String
  issueDate     DateTime        @map("issue_date") @db.Date
  expiryDate    DateTime        @map("expiry_date") @db.Date
  status        GuaranteeStatus @default(ACTIVE)
  notes         String?

  contract    Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  attachments GuaranteeAttachment[]

  @@index([contractId])
  @@index([expiryDate, status])
  @@map("contract_guarantees")
}

model ContractMilestone {
  id          String    @id @default(cuid())
  contractId  String    @map("contract_id")
  name        String
  description String?
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  contract            Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  programmeMilestones ProgrammeMilestone[]

  @@index([contractId])
  @@map("contract_milestones")
}

// ADR-014: shared, immutable file-metadata entity. Bytes live in S3-compatible object storage
// behind FileStoragePort (MinIO first adapter); this row is the metadata + tenant-prefixed key.
// The five *Attachment tables relate to it. Immutable rows (audit-relevant) cannot be deleted.
model PlatformFile {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  originalName   String             @map("original_name")
  mimeType       String             @map("mime_type")
  sizeBytes      Int                @map("size_bytes")
  checksumSha256 String?            @map("checksum_sha256")
  storageBucket  String             @map("storage_bucket")
  storageKey     String             @unique @map("storage_key")
  status         PlatformFileStatus @default(PENDING)
  immutable      Boolean            @default(false)
  uploadedBy     String             @map("uploaded_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  confirmedAt    DateTime?          @map("confirmed_at")

  contractAttachments     ContractAttachment[]
  guaranteeAttachments    GuaranteeAttachment[]
  ipaAttachments          IpaAttachment[]
  ipcAttachments          IpcAttachment[]
  journalEntryAttachments JournalEntryAttachment[]
  projectDocuments        ProjectDocument[]
  dprAttachments          DprAttachment[]

  @@index([organizationId])
  @@map("platform_files")
}

enum PlatformFileStatus {
  PENDING // metadata created; awaiting client upload + confirm
  READY // uploaded and checksum-verified
}

model ContractAttachment {
  id             String   @id @default(cuid())
  contractId     String   @map("contract_id")
  platformFileId String   @map("platform_file_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")

  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  platformFile PlatformFile @relation(fields: [platformFileId], references: [id])

  @@index([contractId])
  @@map("contract_attachments")
}

model GuaranteeAttachment {
  id             String   @id @default(cuid())
  guaranteeId    String   @map("guarantee_id")
  platformFileId String   @map("platform_file_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")

  guarantee    ContractGuarantee @relation(fields: [guaranteeId], references: [id], onDelete: Cascade)
  platformFile PlatformFile      @relation(fields: [platformFileId], references: [id])

  @@index([guaranteeId])
  @@map("guarantee_attachments")
}

// ─── IPA Domain ───────────────────────────────────────────────────────────────

model InterimPaymentApplication {
  id                   String    @id @default(cuid())
  contractId           String    @map("contract_id")
  organizationId       String    @map("organization_id")
  applicationNumber    Int?      @map("application_number")
  applicationRef       String?   @map("application_ref")
  status               IpaStatus @default(DRAFT)
  periodFrom           DateTime? @map("period_from") @db.Date
  periodTo             DateTime? @map("period_to") @db.Date
  submittedAt          DateTime? @map("submitted_at")
  submittedBy          String?   @map("submitted_by")
  exchangeRateCurrency String?   @map("exchange_rate_currency") @db.VarChar(3)
  exchangeRateBase     String?   @map("exchange_rate_base") @db.VarChar(3)
  exchangeRateValue    Decimal?  @map("exchange_rate_value") @db.Decimal(18, 6)
  exchangeRateDate     DateTime? @map("exchange_rate_date") @db.Date
  notes                String?
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  contract     Contract                             @relation(fields: [contractId], references: [id])
  organization Organization                         @relation(fields: [organizationId], references: [id])
  items        InterimPaymentApplicationItem[]
  deductions   InterimPaymentApplicationDeduction[]
  attachments  IpaAttachment[]
  certificates InterimPaymentCertificate[]

  @@unique([contractId, applicationNumber])
  @@index([contractId, status])
  @@index([organizationId])
  @@map("interim_payment_applications")
}

model InterimPaymentApplicationItem {
  id                         String            @id @default(cuid())
  applicationId              String            @map("application_id")
  boqNodeId                  String            @map("boq_node_id")
  measurementMethodSnapshot  MeasurementMethod @map("measurement_method_snapshot")
  unitRateSnapshot           Decimal           @map("unit_rate_snapshot") @db.Decimal(18, 2)
  currencySnapshot           String            @map("currency_snapshot") @db.VarChar(3)
  cumulativeClaimed          Decimal           @map("cumulative_claimed") @db.Decimal(18, 3)
  previousEffectiveCertified Decimal           @default(0) @map("previous_effective_certified") @db.Decimal(18, 3)
  periodQuantity             Decimal           @map("period_quantity") @db.Decimal(18, 3)
  periodAmount               Decimal           @map("period_amount") @db.Decimal(18, 2)

  application      InterimPaymentApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  certificateItems InterimPaymentCertificateItem[]

  @@unique([applicationId, boqNodeId])
  @@index([applicationId])
  @@map("interim_payment_application_items")
}

model InterimPaymentApplicationDeduction {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  deductionType String   @map("deduction_type")
  sourceTermId  String?  @map("source_term_id")
  rate          Decimal? @map("rate") @db.Decimal(5, 4)
  basis         Decimal  @map("basis") @db.Decimal(18, 2)
  amount        Decimal  @map("amount") @db.Decimal(18, 2)

  application InterimPaymentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interim_payment_application_deductions")
}

model IpaAttachment {
  id             String   @id @default(cuid())
  applicationId  String   @map("application_id")
  platformFileId String   @map("platform_file_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")

  application  InterimPaymentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  platformFile PlatformFile              @relation(fields: [platformFileId], references: [id])

  @@index([applicationId])
  @@map("ipa_attachments")
}

// ─── IPC Domain ───────────────────────────────────────────────────────────────

model InterimPaymentCertificate {
  id                   String    @id @default(cuid())
  applicationId        String    @map("application_id")
  organizationId       String    @map("organization_id")
  certificateNumber    Int       @map("certificate_number")
  certificateRef       String?   @map("certificate_ref")
  status               IpcStatus
  isEffective          Boolean   @default(false) @map("is_effective")
  effectiveAt          DateTime? @map("effective_at")
  supersededAt         DateTime? @map("superseded_at")
  supersededById       String?   @map("superseded_by_id")
  supersessionReason   String?   @map("supersession_reason")
  certifiedTotal       Decimal   @map("certified_total") @db.Decimal(18, 2)
  currency             String    @db.VarChar(3)
  exchangeRateCurrency String?   @map("exchange_rate_currency") @db.VarChar(3)
  exchangeRateBase     String?   @map("exchange_rate_base") @db.VarChar(3)
  exchangeRateValue    Decimal?  @map("exchange_rate_value") @db.Decimal(18, 6)
  exchangeRateDate     DateTime? @map("exchange_rate_date") @db.Date
  issuedAt             DateTime? @map("issued_at")
  issuedBy             String?   @map("issued_by")
  notes                String?
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")

  application   InterimPaymentApplication            @relation(fields: [applicationId], references: [id])
  organization  Organization                         @relation(fields: [organizationId], references: [id])
  items         InterimPaymentCertificateItem[]
  deductions    InterimPaymentCertificateDeduction[]
  attachments   IpcAttachment[]
  // Sprint 3 commercial billing tracking (receipt ↔ IPC)
  allocations   ReceiptAllocation[]
  supersededBy  InterimPaymentCertificate?           @relation("CertSupersession", fields: [supersededById], references: [id])
  supersedes    InterimPaymentCertificate[]          @relation("CertSupersession")
  // Sprint 4 — ClientInvoice generated when isEffective becomes true (Correction 10)
  clientInvoice ClientInvoice?

  @@unique([applicationId, certificateNumber])
  @@index([organizationId, status])
  @@index([applicationId, isEffective])
  @@map("interim_payment_certificates")
}

model InterimPaymentCertificateItem {
  id                String  @id @default(cuid())
  certificateId     String  @map("certificate_id")
  applicationItemId String  @map("application_item_id")
  certifiedQuantity Decimal @map("certified_quantity") @db.Decimal(18, 3)
  certifiedAmount   Decimal @map("certified_amount") @db.Decimal(18, 2)
  varianceQuantity  Decimal @map("variance_quantity") @db.Decimal(18, 3)
  varianceReason    String? @map("variance_reason")

  certificate     InterimPaymentCertificate     @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  applicationItem InterimPaymentApplicationItem @relation(fields: [applicationItemId], references: [id])

  @@unique([certificateId, applicationItemId])
  @@index([certificateId])
  @@map("interim_payment_certificate_items")
}

model InterimPaymentCertificateDeduction {
  id            String   @id @default(cuid())
  certificateId String   @map("certificate_id")
  deductionType String   @map("deduction_type")
  sourceTermId  String?  @map("source_term_id")
  rate          Decimal? @map("rate") @db.Decimal(5, 4)
  basis         Decimal  @map("basis") @db.Decimal(18, 2)
  amount        Decimal  @map("amount") @db.Decimal(18, 2)

  certificate InterimPaymentCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("interim_payment_certificate_deductions")
}

model IpcAttachment {
  id             String   @id @default(cuid())
  certificateId  String   @map("certificate_id")
  platformFileId String   @map("platform_file_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")

  certificate  InterimPaymentCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  platformFile PlatformFile              @relation(fields: [platformFileId], references: [id])

  @@index([certificateId])
  @@map("ipc_attachments")
}

// Sprint 3 commercial billing tracking — receipt allocated to IPC (NOT accounting subledger).
// For accounting AR settlement see ClientReceiptAllocation (receipt ↔ ClientInvoice).
model ReceiptAllocation {
  id              String   @id @default(cuid())
  receiptId       String   @map("receipt_id")
  certificateId   String   @map("certificate_id")
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(18, 2)
  allocatedAt     DateTime @default(now()) @map("allocated_at")
  allocatedBy     String   @map("allocated_by")

  receipt     PaymentReceipt            @relation(fields: [receiptId], references: [id])
  certificate InterimPaymentCertificate @relation(fields: [certificateId], references: [id])

  @@index([receiptId])
  @@index([certificateId])
  @@map("receipt_allocations")
}

// ─── Sprint 4: Accounting Foundation ─────────────────────────────────────────

// ─── Dimension Master Data ────────────────────────────────────────────────────

// effectiveTo is EXCLUSIVE: range is [effectiveFrom, effectiveTo).
// Non-overlap enforced via raw SQL exclusion constraint (see raw-sql-constraints.sql).
model Department {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  code           String          @db.VarChar(30)
  status         DimensionStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  createdBy      String          @map("created_by")

  organization  Organization        @relation(fields: [organizationId], references: [id])
  versions      DepartmentVersion[] @relation("DeptVersionOwner")
  childVersions DepartmentVersion[] @relation("DeptVersionParent")
  costCenters   CostCenter[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("departments")
}

model DepartmentVersion {
  id                 String    @id @default(cuid())
  departmentId       String    @map("department_id")
  versionNumber      Int       @map("version_number")
  name               String
  parentDepartmentId String?   @map("parent_department_id")
  // effectiveTo is EXCLUSIVE — [effectiveFrom, effectiveTo)
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  changedBy          String    @map("changed_by")
  changeReason       String?   @map("change_reason")
  createdAt          DateTime  @default(now()) @map("created_at")

  department       Department  @relation("DeptVersionOwner", fields: [departmentId], references: [id])
  parentDepartment Department? @relation("DeptVersionParent", fields: [parentDepartmentId], references: [id])

  @@unique([departmentId, versionNumber])
  @@index([departmentId, effectiveFrom])
  @@map("department_versions")
}

// CostCenter.departmentId is STABLE — part of cost center identity.
// If a cost center changes departments, it is a new root record (old status = INACTIVE).
// Validated at post time: COST_CENTER_DEPARTMENT_MISMATCH if JournalLine.costCenterId
// and JournalLine.departmentId reference inconsistent departments.
model CostCenter {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  code           String          @db.VarChar(30)
  departmentId   String          @map("department_id")
  status         DimensionStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  createdBy      String          @map("created_by")

  department Department          @relation(fields: [departmentId], references: [id])
  versions   CostCenterVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, departmentId, status])
  @@map("cost_centers")
}

model CostCenterVersion {
  id            String    @id @default(cuid())
  costCenterId  String    @map("cost_center_id")
  versionNumber Int       @map("version_number")
  name          String
  // effectiveTo is EXCLUSIVE — [effectiveFrom, effectiveTo)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  changedBy     String    @map("changed_by")
  changeReason  String?   @map("change_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  costCenter CostCenter @relation(fields: [costCenterId], references: [id])

  @@unique([costCenterId, versionNumber])
  @@index([costCenterId, effectiveFrom])
  @@map("cost_center_versions")
}

// ─── Chart of Accounts ────────────────────────────────────────────────────────

// Account.code and Account.normalBalance are PERMANENT — never change after creation.
// All other attributes live in AccountVersion.
// Rename/reclassify → new AccountVersion on same Account root.
// New accounting identity → new Account root (old status = INACTIVE).
model Account {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  code           String        @db.VarChar(20)
  normalBalance  NormalBalance @map("normal_balance")
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  createdBy      String        @map("created_by")

  organization  Organization     @relation(fields: [organizationId], references: [id])
  versions      AccountVersion[] @relation("AccountVersionOwner")
  childVersions AccountVersion[] @relation("AccountVersionParent")
  bankAccount   BankAccount?
  journalLines  JournalLine[]    @relation("JournalLineAccount")

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("accounts")
}

// effectiveTo is EXCLUSIVE — [effectiveFrom, effectiveTo).
// Uniqueness: exactly one version with effectiveTo IS NULL per accountId (the current version).
// Non-overlap enforced via raw SQL exclusion constraint (see raw-sql-constraints.sql).
model AccountVersion {
  id                      String               @id @default(cuid())
  accountId               String               @map("account_id")
  versionNumber           Int                  @map("version_number")
  name                    String
  parentAccountId         String?              @map("parent_account_id")
  accountClass            AccountClass         @map("account_class")
  accountSubtype          AccountSubtype       @map("account_subtype")
  isPostingAllowed        Boolean              @default(true) @map("is_posting_allowed")
  isControlAccount        Boolean              @default(false) @map("is_control_account")
  controlledSubledgerType SubledgerType?       @map("controlled_subledger_type")
  // UNRESTRICTED | SYSTEM_ONLY | SYSTEM_OR_APPROVED_ADJUSTMENT
  controlPostingPolicy    ControlPostingPolicy @default(UNRESTRICTED) @map("control_posting_policy")
  // effectiveTo is EXCLUSIVE — [effectiveFrom, effectiveTo)
  effectiveFrom           DateTime             @map("effective_from") @db.Date
  effectiveTo             DateTime?            @map("effective_to") @db.Date
  changedBy               String               @map("changed_by")
  changeReason            String?              @map("change_reason")
  createdAt               DateTime             @default(now()) @map("created_at")

  account       Account       @relation("AccountVersionOwner", fields: [accountId], references: [id])
  parentAccount Account?      @relation("AccountVersionParent", fields: [parentAccountId], references: [id])
  journalLines  JournalLine[]

  @@unique([accountId, versionNumber])
  @@index([accountId, effectiveFrom])
  @@map("account_versions")
}

// ─── Fiscal Calendar ──────────────────────────────────────────────────────────

model FiscalYear {
  id                        String           @id @default(cuid())
  organizationId            String           @map("organization_id")
  name                      String           @db.VarChar(20)
  startDate                 DateTime         @map("start_date") @db.Date
  endDate                   DateTime         @map("end_date") @db.Date
  // FK to Account; retainedEarningsAccountId must reference an EQUITY account.
  retainedEarningsAccountId String           @map("retained_earnings_account_id")
  status                    FiscalYearStatus @default(DRAFT)
  closedAt                  DateTime?        @map("closed_at")
  closedBy                  String?          @map("closed_by")
  createdAt                 DateTime         @default(now()) @map("created_at")
  createdBy                 String           @map("created_by")

  organization Organization       @relation(fields: [organizationId], references: [id])
  periods      AccountingPeriod[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("fiscal_years")
}

// Period-close sequence (Correction 3):
//   OPEN → normal postings allowed
//   LOCKED → only CLOSING_ADJUSTMENT category journals allowed; period-close in progress
//   CLOSED → permanent; no further postings
//   REOPENED → exceptional CFO-only action; treated as OPEN but flagged
//
// Year-end for ACCO (no Period 13):
//   Period 12 OPEN → normal December transactions
//   Period 12 LOCKED → closing adjustments + year-end closing journal posted
//   Generate final Period 12 PeriodAccountBalance snapshot
//   Period 12 CLOSED → FiscalYear CLOSED
//   REOPENED is reserved for exceptional post-close corrections only.
model AccountingPeriod {
  id               String       @id @default(cuid())
  fiscalYearId     String       @map("fiscal_year_id")
  organizationId   String       @map("organization_id")
  periodNumber     Int          @map("period_number")
  name             String       @db.VarChar(30)
  startDate        DateTime     @map("start_date") @db.Date
  endDate          DateTime     @map("end_date") @db.Date
  periodType       PeriodType   @default(OPERATING) @map("period_type")
  status           PeriodStatus @default(OPEN)
  // REOPENED tracking
  reopenReason     String?      @map("reopen_reason")
  reopenedBy       String?      @map("reopened_by")
  reopenedAt       DateTime?    @map("reopened_at")
  reopenApprovedBy String?      @map("reopen_approved_by")
  createdAt        DateTime     @default(now()) @map("created_at")

  fiscalYear     FiscalYear             @relation(fields: [fiscalYearId], references: [id])
  journalEntries JournalEntry[]
  balances       PeriodAccountBalance[]

  @@unique([fiscalYearId, periodNumber])
  @@index([organizationId, status])
  @@map("accounting_periods")
}

// ─── Banking ──────────────────────────────────────────────────────────────────

model TreasuryGroup {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  name           String
  status         DimensionStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  createdBy      String          @map("created_by")

  organization Organization  @relation(fields: [organizationId], references: [id])
  bankAccounts BankAccount[]

  @@unique([organizationId, name])
  @@map("treasury_groups")
}

// Each BankAccount is 1:1 with one GL Account (CASH_AND_BANK subtype).
// controlPostingPolicy on the linked Account should be SYSTEM_OR_APPROVED_ADJUSTMENT.
model BankAccount {
  id              String            @id @default(cuid())
  organizationId  String            @map("organization_id")
  glAccountId     String            @unique @map("gl_account_id")
  bankName        String            @map("bank_name")
  accountName     String            @map("account_name")
  accountNumber   String            @map("account_number") @db.VarChar(50)
  iban            String?           @db.VarChar(34)
  swiftCode       String?           @map("swift_code") @db.VarChar(11)
  currencyCode    String            @map("currency_code") @db.VarChar(3)
  branch          String?
  treasuryGroupId String?           @map("treasury_group_id")
  allowsReceipts  Boolean           @default(true) @map("allows_receipts")
  allowsPayments  Boolean           @default(true) @map("allows_payments")
  isReconcilable  Boolean           @default(true) @map("is_reconcilable")
  status          BankAccountStatus @default(ACTIVE)
  openedAt        DateTime?         @map("opened_at") @db.Date
  closedAt        DateTime?         @map("closed_at") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at")
  createdBy       String            @map("created_by")

  glAccount        Account           @relation(fields: [glAccountId], references: [id])
  treasuryGroup    TreasuryGroup?    @relation(fields: [treasuryGroupId], references: [id])
  receipts         PaymentReceipt[]
  supplierPayments SupplierPayment[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId, status])
  @@map("bank_accounts")
}

// ─── Tax ──────────────────────────────────────────────────────────────────────

// For ACCO: recoveryMethod = NON_RECOVERABLE for input VAT.
// NON_RECOVERABLE: vatAmount stored on SupplierBillLine for audit only.
// Gross amount (net + VAT) posts to expense/inventory. No separate GL VAT line.
model TaxCode {
  id                 String         @id @default(cuid())
  organizationId     String         @map("organization_id")
  code               String         @db.VarChar(10)
  name               String
  rate               Decimal        @db.Decimal(7, 4)
  taxType            TaxType        @map("tax_type")
  recoveryMethod     RecoveryMethod @map("recovery_method")
  outputTaxAccountId String?        @map("output_tax_account_id")
  inputTaxAccountId  String?        @map("input_tax_account_id")
  effectiveFrom      DateTime       @map("effective_from") @db.Date
  effectiveTo        DateTime?      @map("effective_to") @db.Date
  status             TaxCodeStatus  @default(ACTIVE)
  createdAt          DateTime       @default(now()) @map("created_at")
  createdBy          String         @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("tax_codes")
}

// ─── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id               String         @id @default(cuid())
  organizationId   String         @map("organization_id")
  code             String         @db.VarChar(30)
  name             String
  taxNumber        String?        @map("tax_number")
  defaultCurrency  String?        @map("default_currency") @db.VarChar(3)
  paymentTermsDays Int?           @map("payment_terms_days")
  status           SupplierStatus @default(ACTIVE)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organization     Organization              @relation(fields: [organizationId], references: [id])
  contacts         SupplierContact[]
  bills            SupplierBill[]
  payments         SupplierPayment[]
  // Sprint 5 — Procurement
  purchaseOrders   PurchaseOrder[]
  grnNotes         GoodsReceiptNote[]
  matchingPolicies MatchingTolerancePolicy[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("suppliers")
}

model SupplierContact {
  id         String  @id @default(cuid())
  supplierId String  @map("supplier_id")
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean @default(false) @map("is_primary")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

// ─── Posting Profiles ─────────────────────────────────────────────────────────

// PostingProfile.code is the permanent semantic key (e.g. PROJECT_REVENUE, MATERIAL_PURCHASE).
// All versioned attributes (name, accountId) live in PostingProfileVersion.
// PostingRuleLineTemplate.postingProfileId → PostingProfile.id (stable).
// JournalLine.resolutionSource records "PROJECT_REVENUE@v3" as immutable audit snapshot.
model PostingProfile {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  code           String        @db.VarChar(50)
  status         ProfileStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  createdBy      String        @map("created_by")

  organization  Organization              @relation(fields: [organizationId], references: [id])
  versions      PostingProfileVersion[]
  ruleTemplates PostingRuleLineTemplate[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("posting_profiles")
}

// effectiveTo is EXCLUSIVE — [effectiveFrom, effectiveTo).
// Version resolution: WHERE effectiveFrom <= accountingDate AND (effectiveTo IS NULL OR accountingDate < effectiveTo)
model PostingProfileVersion {
  id               String    @id @default(cuid())
  postingProfileId String    @map("posting_profile_id")
  versionNumber    Int       @map("version_number")
  name             String
  description      String?
  accountId        String    @map("account_id")
  // effectiveTo is EXCLUSIVE — [effectiveFrom, effectiveTo)
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  changedBy        String    @map("changed_by")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  profile      PostingProfile @relation(fields: [postingProfileId], references: [id])
  journalLines JournalLine[]

  @@unique([postingProfileId, versionNumber])
  @@index([postingProfileId, effectiveFrom])
  @@map("posting_profile_versions")
}

// ─── Posting Rules ────────────────────────────────────────────────────────────

model PostingRuleVersion {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  eventType      String     @map("event_type")
  eventVersion   Int        @map("event_version")
  version        Int
  effectiveFrom  DateTime   @map("effective_from") @db.Date
  effectiveTo    DateTime?  @map("effective_to") @db.Date
  status         RuleStatus @default(DRAFT)
  createdBy      String     @map("created_by")
  approvedBy     String?    @map("approved_by")
  approvedAt     DateTime?  @map("approved_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  lines PostingRuleLineTemplate[]

  @@unique([organizationId, eventType, version])
  @@index([organizationId, eventType, status])
  @@map("posting_rule_versions")
}

model PostingRuleLineTemplate {
  id                    String          @id @default(cuid())
  postingRuleVersionId  String          @map("posting_rule_version_id")
  lineNumber            Int             @map("line_number")
  lineRole              String          @map("line_role")
  debitOrCredit         DebitCredit     @map("debit_or_credit")
  amountSource          String          @map("amount_source")
  accountResolutionType ResolutionType  @map("account_resolution_type")
  // Used when accountResolutionType = FIXED_ACCOUNT
  fixedAccountId        String?         @map("fixed_account_id")
  // Used when accountResolutionType = ACCOUNT_SUBTYPE_LOOKUP
  accountSubtype        AccountSubtype? @map("account_subtype")
  // Used when accountResolutionType = POSTING_PROFILE (FK to stable PostingProfile)
  postingProfileId      String?         @map("posting_profile_id")
  condition             String?
  requiredDimensions    String[]        @map("required_dimensions")
  descriptionTemplate   String?         @map("description_template")

  rule           PostingRuleVersion @relation(fields: [postingRuleVersionId], references: [id])
  postingProfile PostingProfile?    @relation(fields: [postingProfileId], references: [id])

  @@unique([postingRuleVersionId, lineNumber])
  @@map("posting_rule_line_templates")
}

// ─── Document Numbering ───────────────────────────────────────────────────────

// nextNumber is allocated with SELECT FOR UPDATE at POST time only.
// No gaps permitted — failures roll back the main transaction before number allocation.
model DocumentNumberSequence {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  documentType    DocumentType     @map("document_type")
  journalCategory JournalCategory? @map("journal_category")
  prefix          String           @db.VarChar(10)
  nextNumber      Int              @default(1) @map("next_number")
  paddingLength   Int              @default(6) @map("padding_length")
  // Optimistic concurrency — checked before update
  version         Int              @default(1)
  status          SequenceStatus   @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([organizationId, documentType, journalCategory])
  @@map("document_number_sequences")
}

// ─── AR Subledger ─────────────────────────────────────────────────────────────

// ClientInvoice is generated automatically when an IPC transitions to isEffective = true
// (Correction 10). NOT merely on approval — the trigger is IPC.isEffective.
//
// ACCO policy (Correction 9): one ClientInvoice per effective IPC.
// Enforced by @@unique([organizationId, sourceIpcId]).
//
// IPC supersession protocol:
//   Draft invoice → CANCELLED, new DRAFT generated from new effective IPC
//   Approved+unposted → Finance manually cancels, new invoice generated
//   Posted → credit note (reversal JournalEntry) + replacement ClientInvoice
model ClientInvoice {
  id                     String           @id @default(cuid())
  organizationId         String           @map("organization_id")
  invoiceNumber          String?          @map("invoice_number") @db.VarChar(30)
  invoiceDate            DateTime         @map("invoice_date") @db.Date
  dueDate                DateTime         @map("due_date") @db.Date
  clientId               String           @map("client_id")
  // sourceIpcId: the effective IPC that generated this invoice. NULL for migration-loaded records.
  sourceIpcId            String?          @unique @map("source_ipc_id")
  // ADR-023: the payment-schedule installment that generated this invoice (MILESTONE contracts).
  // Unique → one invoice per installment (idempotent billing). Mutually exclusive with sourceIpcId.
  sourceInstallmentId    String?          @unique @map("source_installment_id")
  projectId              String?          @map("project_id")
  contractId             String?          @map("contract_id")
  currencyCode           String           @map("currency_code") @db.VarChar(3)
  exchangeRateSnapshot   Decimal          @map("exchange_rate_snapshot") @db.Decimal(18, 6)
  exchangeRateDate       DateTime         @map("exchange_rate_date") @db.Date
  exchangeRateSource     String           @map("exchange_rate_source")
  subtotal               Decimal          @db.Decimal(18, 2)
  vatAmount              Decimal          @map("vat_amount") @db.Decimal(18, 2)
  totalAmount            Decimal          @map("total_amount") @db.Decimal(18, 2)
  outstandingAmount      Decimal          @map("outstanding_amount") @db.Decimal(18, 2)
  paymentTerms           String?          @map("payment_terms")
  billingAddressSnapshot Json             @map("billing_address_snapshot")
  documentStatus         InvoiceDocStatus @default(DRAFT) @map("document_status")
  postingStatus          PostingStatus    @default(NOT_POSTED) @map("posting_status")
  postedJournalEntryId   String?          @map("posted_journal_entry_id")
  postedAt               DateTime?        @map("posted_at")
  postedBy               String?          @map("posted_by")
  reversedAt             DateTime?        @map("reversed_at")
  reversedBy             String?          @map("reversed_by")
  reversalJournalEntryId String?          @map("reversal_journal_entry_id")
  cancelledAt            DateTime?        @map("cancelled_at")
  cancelledBy            String?          @map("cancelled_by")
  cancellationReason     String?          @map("cancellation_reason")
  lastPostingAttemptAt   DateTime?        @map("last_posting_attempt_at")
  lastPostingErrorCode   String?          @map("last_posting_error_code")
  migrationBatchId       String?          @map("migration_batch_id")
  revision               Int              @default(1)
  createdBy              String           @map("created_by")
  approvedBy             String?          @map("approved_by")
  approvedAt             DateTime?        @map("approved_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  organization      Organization                @relation(fields: [organizationId], references: [id])
  client            Client                      @relation(fields: [clientId], references: [id])
  sourceIpc         InterimPaymentCertificate?  @relation(fields: [sourceIpcId], references: [id])
  sourceInstallment ContractPaymentInstallment? @relation(fields: [sourceInstallmentId], references: [id])
  allocations       ClientReceiptAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, clientId, postingStatus])
  @@index([organizationId, documentStatus])
  @@map("client_invoices")
}

// Accounting subledger: PaymentReceipt ↔ ClientInvoice for GL posting.
// Distinct from ReceiptAllocation (receipt ↔ IPC) which is commercial billing tracking.
//
// Allocation lifecycle:
//   INITIAL (at payment post time): postingStatus = POSTED; journalEntryId = paymentJournalEntryId
//   SUBSEQUENT (post-payment allocation of unallocated amount): postingStatus starts NOT_POSTED;
//     CLIENT_RECEIPT_ALLOCATED journal (EVT-AR-005) is posted → postingStatus = POSTED
//   REVERSAL of subsequent: CLIENT_RECEIPT_ALLOCATED.REVERSED (EVT-AR-006) → postingStatus = REVERSED
//   Initial allocations cannot be individually reversed — reverse the payment (EVT-AR-004) instead.
//
// Invariants enforced by use case before commit:
//   PaymentReceipt.totalAmount = allocatedAmount + unallocatedAmount  (always)
//   ∑ ClientReceiptAllocation.allocatedAmount WHERE postingStatus IN (POSTED) = PaymentReceipt.allocatedAmount
model ClientReceiptAllocation {
  id                     String        @id @default(cuid())
  organizationId         String        @map("organization_id")
  paymentReceiptId       String        @map("payment_receipt_id")
  clientInvoiceId        String        @map("client_invoice_id")
  allocatedAmount        Decimal       @map("allocated_amount") @db.Decimal(18, 2)
  allocationDate         DateTime      @map("allocation_date") @db.Date
  // journalEntryId: for initial allocations = payment journal; for subsequent = allocation journal
  journalEntryId         String?       @map("journal_entry_id")
  postingStatus          PostingStatus @default(NOT_POSTED) @map("posting_status")
  reversalJournalEntryId String?       @map("reversal_journal_entry_id")
  createdBy              String        @map("created_by")
  createdAt              DateTime      @default(now()) @map("created_at")

  receipt PaymentReceipt @relation(fields: [paymentReceiptId], references: [id])
  invoice ClientInvoice  @relation(fields: [clientInvoiceId], references: [id])

  @@index([paymentReceiptId])
  @@index([clientInvoiceId])
  @@map("client_receipt_allocations")
}

// ─── Payment Receipts (expanded from Sprint 3 stub) ───────────────────────────

// Sprint 3 columns preserved; Sprint 4 adds accounting fields.
// Migration note: rename column `amount` → `total_amount`, `exchange_rate` → `exchange_rate_snapshot`.
// Correction 1: totalAmount = allocatedAmount + unallocatedAmount.
// Unallocated portion posts Dr Bank / Cr Unapplied Client Receipts (CLIENT_ADVANCE_LIABILITY).
model PaymentReceipt {
  id                   String           @id @default(cuid())
  organizationId       String           @map("organization_id")
  clientId             String           @map("client_id")
  bankAccountId        String?          @map("bank_account_id")
  receiptDate          DateTime         @map("receipt_date") @db.Date
  accountingDate       DateTime         @map("accounting_date") @db.Date
  totalAmount          Decimal          @map("total_amount") @db.Decimal(18, 2)
  allocatedAmount      Decimal          @default(0) @map("allocated_amount") @db.Decimal(18, 2)
  unallocatedAmount    Decimal          @map("unallocated_amount") @db.Decimal(18, 2)
  currencyCode         String           @map("currency_code") @db.VarChar(3)
  exchangeRateSnapshot Decimal?         @map("exchange_rate_snapshot") @db.Decimal(18, 6)
  exchangeRateDate     DateTime?        @map("exchange_rate_date") @db.Date
  exchangeRateSource   String?          @map("exchange_rate_source")
  paymentMethod        String?          @map("payment_method")
  bankReference        String?          @map("bank_reference")
  reference            String?
  notes                String?
  documentStatus       PaymentDocStatus @default(DRAFT) @map("document_status")
  postingStatus        PostingStatus    @default(NOT_POSTED) @map("posting_status")
  postedJournalEntryId String?          @map("posted_journal_entry_id")
  postedAt             DateTime?        @map("posted_at")
  postedBy             String?          @map("posted_by")
  lastPostingAttemptAt DateTime?        @map("last_posting_attempt_at")
  lastPostingErrorCode String?          @map("last_posting_error_code")
  migrationBatchId     String?          @map("migration_batch_id")
  revision             Int              @default(1)
  createdBy            String           @map("created_by")
  approvedBy           String?          @map("approved_by")
  approvedAt           DateTime?        @map("approved_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization      Organization              @relation(fields: [organizationId], references: [id])
  client            Client                    @relation(fields: [clientId], references: [id])
  bankAccount       BankAccount?              @relation(fields: [bankAccountId], references: [id])
  // Sprint 3 commercial billing tracking (receipt ↔ IPC)
  allocations       ReceiptAllocation[]
  // Sprint 4 accounting subledger (receipt ↔ ClientInvoice)
  clientAllocations ClientReceiptAllocation[]

  @@index([organizationId, clientId])
  @@index([organizationId, postingStatus])
  @@index([receiptDate])
  @@map("payment_receipts")
}

// ─── AP Subledger ─────────────────────────────────────────────────────────────

model SupplierBill {
  id                        String          @id @default(cuid())
  organizationId            String          @map("organization_id")
  supplierId                String          @map("supplier_id")
  billNumber                String?         @map("bill_number") @db.VarChar(30)
  supplierInvoiceNumber     String          @map("supplier_invoice_number")
  supplierInvoiceNumberNorm String          @map("supplier_invoice_number_norm")
  billDate                  DateTime        @map("bill_date") @db.Date
  dueDate                   DateTime        @map("due_date") @db.Date
  currencyCode              String          @map("currency_code") @db.VarChar(3)
  exchangeRateSnapshot      Decimal         @map("exchange_rate_snapshot") @db.Decimal(18, 6)
  exchangeRateDate          DateTime        @map("exchange_rate_date") @db.Date
  exchangeRateSource        String          @map("exchange_rate_source")
  purchaseOrderId           String?         @map("purchase_order_id")
  purchaseOrderRevisionId   String?         @map("purchase_order_revision_id")
  // Sprint 5: bill matching gate — posting blocked unless MATCHED/MATCHED_WITH_TOLERANCE/APPROVED_EXCEPTION
  matchStatus               BillMatchStatus @default(NOT_RUN) @map("match_status")
  projectId                 String?         @map("project_id")
  departmentId              String?         @map("department_id")
  subtotal                  Decimal         @db.Decimal(18, 2)
  vatAmount                 Decimal         @map("vat_amount") @db.Decimal(18, 2)
  totalAmount               Decimal         @map("total_amount") @db.Decimal(18, 2)
  outstandingAmount         Decimal         @map("outstanding_amount") @db.Decimal(18, 2)
  documentStatus            BillDocStatus   @default(DRAFT) @map("document_status")
  postingStatus             PostingStatus   @default(NOT_POSTED) @map("posting_status")
  postedJournalEntryId      String?         @map("posted_journal_entry_id")
  postedAt                  DateTime?       @map("posted_at")
  postedBy                  String?         @map("posted_by")
  reversedAt                DateTime?       @map("reversed_at")
  reversedBy                String?         @map("reversed_by")
  reversalJournalEntryId    String?         @map("reversal_journal_entry_id")
  lastPostingAttemptAt      DateTime?       @map("last_posting_attempt_at")
  lastPostingErrorCode      String?         @map("last_posting_error_code")
  migrationBatchId          String?         @map("migration_batch_id")
  revision                  Int             @default(1)
  createdBy                 String          @map("created_by")
  approvedBy                String?         @map("approved_by")
  approvedAt                DateTime?       @map("approved_at")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  organization Organization                @relation(fields: [organizationId], references: [id])
  supplier     Supplier                    @relation(fields: [supplierId], references: [id])
  lines        SupplierBillLine[]
  allocations  SupplierPaymentAllocation[]

  @@unique([organizationId, supplierId, supplierInvoiceNumberNorm])
  @@unique([organizationId, billNumber])
  @@index([organizationId, postingStatus])
  @@index([supplierId])
  @@map("supplier_bills")
}

// VAT on supplier bills (NON_RECOVERABLE per ACC-TAX-001):
//   vatAmount stored for audit trail only.
//   grossAmount (= netAmount + vatAmount) posts to expense/inventory.
//   No separate GL VAT debit line.
model SupplierBillLine {
  id                  String              @id @default(cuid())
  supplierBillId      String              @map("supplier_bill_id")
  lineNumber          Int                 @map("line_number")
  description         String
  quantity            Decimal?            @db.Decimal(18, 4)
  unitPrice           Decimal?            @map("unit_price") @db.Decimal(18, 4)
  netAmount           Decimal             @map("net_amount") @db.Decimal(18, 2)
  vatCodeId           String?             @map("vat_code_id")
  vatAmount           Decimal             @map("vat_amount") @db.Decimal(18, 2)
  // grossAmount = netAmount + vatAmount; this is the amount posted to expense/inventory GL
  grossAmount         Decimal             @map("gross_amount") @db.Decimal(18, 2)
  // Resolved at post time: PostingProfile.code identifying expense/inventory account
  expenseProfileCode  String              @map("expense_profile_code") @db.VarChar(50)
  projectId           String?             @map("project_id")
  departmentId        String?             @map("department_id")
  costCenterId        String?             @map("cost_center_id")
  boqNodeId           String?             @map("boq_node_id")
  purchaseOrderLineId String?             @map("purchase_order_line_id")
  // Sprint 5: material catalogue linkage
  materialId          String?             @map("material_id")
  spendCategoryId     String?             @map("spend_category_id")
  unitOfMeasureId     String?             @map("unit_of_measure_id")
  lineType            ProcurementLineType @default(SERVICE) @map("line_type")

  bill     SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  material Material?    @relation(fields: [materialId], references: [id])

  @@unique([supplierBillId, lineNumber])
  @@map("supplier_bill_lines")
}

// Supplier payment posting (Correction 2):
//   totalAmount = allocatedAmount + unallocatedAmount
//   Dr Accounts Payable          allocatedAmount    (sum of all bill allocations)
//   Dr Supplier Advance          unallocatedAmount  (SUPPLIER_ADVANCE subtype — asset)
//   Cr Bank                      totalAmount
//
//   When advance is later applied against a bill:
//   Dr Accounts Payable          amount
//   Cr Supplier Advance          amount
model SupplierPayment {
  id                   String           @id @default(cuid())
  organizationId       String           @map("organization_id")
  supplierId           String           @map("supplier_id")
  bankAccountId        String           @map("bank_account_id")
  paymentNumber        String?          @map("payment_number") @db.VarChar(30)
  paymentDate          DateTime         @map("payment_date") @db.Date
  accountingDate       DateTime         @map("accounting_date") @db.Date
  currencyCode         String           @map("currency_code") @db.VarChar(3)
  exchangeRateSnapshot Decimal          @map("exchange_rate_snapshot") @db.Decimal(18, 6)
  exchangeRateDate     DateTime         @map("exchange_rate_date") @db.Date
  exchangeRateSource   String           @map("exchange_rate_source")
  totalAmount          Decimal          @map("total_amount") @db.Decimal(18, 2)
  allocatedAmount      Decimal          @default(0) @map("allocated_amount") @db.Decimal(18, 2)
  unallocatedAmount    Decimal          @map("unallocated_amount") @db.Decimal(18, 2)
  paymentMethod        String           @map("payment_method")
  bankReference        String?          @map("bank_reference")
  notes                String?
  documentStatus       PaymentDocStatus @default(DRAFT) @map("document_status")
  postingStatus        PostingStatus    @default(NOT_POSTED) @map("posting_status")
  postedJournalEntryId String?          @map("posted_journal_entry_id")
  postedAt             DateTime?        @map("posted_at")
  postedBy             String?          @map("posted_by")
  lastPostingAttemptAt DateTime?        @map("last_posting_attempt_at")
  lastPostingErrorCode String?          @map("last_posting_error_code")
  migrationBatchId     String?          @map("migration_batch_id")
  revision             Int              @default(1)
  createdBy            String           @map("created_by")
  approvedBy           String?          @map("approved_by")
  approvedAt           DateTime?        @map("approved_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization Organization                @relation(fields: [organizationId], references: [id])
  supplier     Supplier                    @relation(fields: [supplierId], references: [id])
  bankAccount  BankAccount                 @relation(fields: [bankAccountId], references: [id])
  allocations  SupplierPaymentAllocation[]

  @@index([organizationId, postingStatus])
  @@index([supplierId])
  @@map("supplier_payments")
}

// Allocation lifecycle:
//   INITIAL (at payment post time): postingStatus = POSTED; journalEntryId = paymentJournalEntryId
//   SUBSEQUENT (applying supplier advance to a bill): starts NOT_POSTED;
//     SUPPLIER_ADVANCE_ALLOCATED journal (EVT-AP-005) → postingStatus = POSTED
//   REVERSAL of subsequent: EVT-AP-006 → postingStatus = REVERSED
//   Initial allocations cannot be individually reversed — reverse the payment (EVT-AP-004) instead.
//
// Invariants enforced by use case before commit:
//   SupplierPayment.totalAmount = allocatedAmount + unallocatedAmount  (always)
//   ∑ SupplierPaymentAllocation.allocatedAmount WHERE postingStatus IN (POSTED) = SupplierPayment.allocatedAmount
model SupplierPaymentAllocation {
  id                     String        @id @default(cuid())
  organizationId         String        @map("organization_id")
  supplierPaymentId      String        @map("supplier_payment_id")
  supplierBillId         String        @map("supplier_bill_id")
  allocatedAmount        Decimal       @map("allocated_amount") @db.Decimal(18, 2)
  allocationDate         DateTime      @map("allocation_date") @db.Date
  journalEntryId         String?       @map("journal_entry_id")
  postingStatus          PostingStatus @default(NOT_POSTED) @map("posting_status")
  reversalJournalEntryId String?       @map("reversal_journal_entry_id")
  createdBy              String        @map("created_by")
  createdAt              DateTime      @default(now()) @map("created_at")

  payment SupplierPayment @relation(fields: [supplierPaymentId], references: [id])
  bill    SupplierBill    @relation(fields: [supplierBillId], references: [id])

  @@index([supplierPaymentId])
  @@index([supplierBillId])
  @@map("supplier_payment_allocations")
}

// ─── General Ledger ───────────────────────────────────────────────────────────

// Manual journal workflow (Correction 6):
//   Accountant creates DRAFT → submits → CFO approves/rejects → Accountant posts → POSTED
//   Correction via reversal + replacement only (ACC-006, ACC-007).
//   Four-eyes: creator ≠ approver (enforced by application + PostingPolicy.requireFourEyesOnJournals).
//
// POSTED entries are IMMUTABLE — status, lines, amounts cannot change.
// PostingAttempt is written in a SEPARATE small transaction if main tx rolls back.
model JournalEntry {
  id                       String          @id @default(cuid())
  organizationId           String          @map("organization_id")
  journalNumber            String?         @map("journal_number") @db.VarChar(30)
  accountingPeriodId       String?         @map("accounting_period_id")
  journalCategory          JournalCategory @map("journal_category")
  entryPurpose             EntryPurpose    @map("entry_purpose")
  status                   JournalStatus   @default(DRAFT)
  documentDate             DateTime        @map("document_date") @db.Date
  // accountingDate determines the period. Must fall within an OPEN or LOCKED period.
  // LOCKED periods only accept CLOSING_ADJUSTMENT category journals.
  accountingDate           DateTime        @map("accounting_date") @db.Date
  postedAt                 DateTime?       @map("posted_at")
  description              String
  currencyCode             String          @map("currency_code") @db.VarChar(3)
  exchangeRateSnapshot     Decimal?        @map("exchange_rate_snapshot") @db.Decimal(18, 6)
  sourceDocumentType       SourceDocType?  @map("source_document_type")
  sourceDocumentId         String?         @map("source_document_id")
  accountingEventId        String?         @map("accounting_event_id")
  eventVersion             Int?            @map("event_version")
  postingRuleVersionId     String?         @map("posting_rule_version_id")
  // Self-references for reversal and replacement chains
  reversalOfJournalEntryId String?         @map("reversal_of_journal_entry_id")
  replacedByJournalEntryId String?         @map("replaced_by_journal_entry_id")
  createdBy                String          @map("created_by")
  submittedBy              String?         @map("submitted_by")
  submittedAt              DateTime?       @map("submitted_at")
  approvedBy               String?         @map("approved_by")
  approvedAt               DateTime?       @map("approved_at")
  rejectedBy               String?         @map("rejected_by")
  rejectedAt               DateTime?       @map("rejected_at")
  rejectionReason          String?         @map("rejection_reason")
  postedBy                 String?         @map("posted_by")
  reversedBy               String?         @map("reversed_by")
  reversalReason           String?         @map("reversal_reason")
  revision                 Int             @default(1)
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  organization     Organization             @relation(fields: [organizationId], references: [id])
  accountingPeriod AccountingPeriod?        @relation(fields: [accountingPeriodId], references: [id])
  lines            JournalLine[]
  attachments      JournalEntryAttachment[]
  reversalOf       JournalEntry?            @relation("JournalReversal", fields: [reversalOfJournalEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals        JournalEntry[]           @relation("JournalReversal")
  replacedBy       JournalEntry?            @relation("JournalReplacement", fields: [replacedByJournalEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacements     JournalEntry[]           @relation("JournalReplacement")

  // Prevents duplicate system-generated journals for the same source event
  @@unique([organizationId, sourceDocumentType, sourceDocumentId, accountingEventId])
  @@unique([organizationId, journalNumber])
  @@index([organizationId, accountingDate])
  @@index([organizationId, status])
  @@index([accountingPeriodId])
  @@map("journal_entries")
}

// JournalLine amounts: exactly one of (debitAmount > 0, creditAmount > 0) per line.
// Invariant enforced at post: ∑ debitAmount = ∑ creditAmount across all lines (ACC-003).
// Defense-in-depth DB trigger: see raw-sql-constraints.sql.
//
// Snapshot fields (accountCodeSnapshot, accountNameSnapshot, accountVersionNumber)
// are immutable records of what was active at accountingDate — never updated.
//
// Version resolution (Correction 4): uses accountingDate, not period.endDate or generatedAt.
// SQL: WHERE effectiveFrom <= accountingDate AND (effectiveTo IS NULL OR accountingDate < effectiveTo)
model JournalLine {
  id                      String         @id @default(cuid())
  journalEntryId          String         @map("journal_entry_id")
  lineNumber              Int            @map("line_number")
  // Stable account FK + immutable snapshots taken at post time
  accountId               String         @map("account_id")
  accountVersionId        String?        @map("account_version_id")
  accountCodeSnapshot     String         @map("account_code_snapshot") @db.VarChar(20)
  accountNameSnapshot     String         @map("account_name_snapshot")
  accountVersionNumber    Int            @map("account_version_number")
  debitAmount             Decimal        @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount            Decimal        @default(0) @map("credit_amount") @db.Decimal(18, 2)
  transactionCurrencyCode String         @map("transaction_currency_code") @db.VarChar(3)
  transactionAmount       Decimal?       @map("transaction_amount") @db.Decimal(18, 2)
  baseCurrencyAmount      Decimal        @map("base_currency_amount") @db.Decimal(18, 2)
  exchangeRateSnapshot    Decimal?       @map("exchange_rate_snapshot") @db.Decimal(18, 6)
  description             String?
  postingOrigin           PostingOrigin  @map("posting_origin")
  sourceSubledgerType     SubledgerType? @map("source_subledger_type")
  // PostingProfile resolution audit: "PROJECT_REVENUE@v3" — immutable snapshot
  resolutionSource        String?        @map("resolution_source")
  // FK to exact PostingProfileVersion used (Correction 8)
  postingProfileVersionId String?        @map("posting_profile_version_id")
  postingRuleVersionId    String?        @map("posting_rule_version_id")
  // Dimensions
  projectId               String?        @map("project_id")
  departmentId            String?        @map("department_id")
  costCenterId            String?        @map("cost_center_id")
  clientId                String?        @map("client_id")
  supplierId              String?        @map("supplier_id")
  contractId              String?        @map("contract_id")
  boqNodeId               String?        @map("boq_node_id")
  taxCodeId               String?        @map("tax_code_id")
  createdAt               DateTime       @default(now()) @map("created_at")

  entry                 JournalEntry           @relation(fields: [journalEntryId], references: [id])
  account               Account                @relation("JournalLineAccount", fields: [accountId], references: [id])
  accountVersion        AccountVersion?        @relation(fields: [accountVersionId], references: [id])
  postingProfileVersion PostingProfileVersion? @relation(fields: [postingProfileVersionId], references: [id])

  @@unique([journalEntryId, lineNumber])
  @@index([accountId, createdAt])
  @@index([journalEntryId])
  // Dimension indexes for project-scoped reporting (Project Actual P&L, ADR-013)
  @@index([projectId])
  @@index([contractId])
  @@map("journal_lines")
}

// Attachments on POSTED journals are immutable — they cannot be deleted (audit evidence).
// isPostSubmission = true: supplementary evidence added after posting (permitted).
// isPostSubmission = false: evidence uploaded before or during posting workflow.
// Application enforces: DELETE is prohibited on any attachment where journal.status = POSTED.
// New attachments to POSTED journals require CFO permission or designated Finance role.
model JournalEntryAttachment {
  id               String   @id @default(cuid())
  journalEntryId   String   @map("journal_entry_id")
  platformFileId   String   @map("platform_file_id")
  attachmentType   String?  @map("attachment_type")
  // true when added after journal was POSTED (supplementary evidence); false = pre-post upload
  isPostSubmission Boolean  @default(false) @map("is_post_submission")
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String   @map("created_by")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  platformFile PlatformFile @relation(fields: [platformFileId], references: [id])

  @@index([journalEntryId])
  @@map("journal_entry_attachments")
}

// ─── Reporting Snapshots ──────────────────────────────────────────────────────

// Snapshots are generated ONLY after all postings for a period are complete.
// For normal periods: after period transitions to LOCKED (pre-close snapshot).
// For year-end: after all December closing journals post AND before period CLOSED.
// Never generated from generatedAt (Correction 4) — always from accountingDate period boundaries.
//
// Open-period balance query:
//   closing balance = latest valid snapshot closing balance
//                   + JournalLine movements WHERE accountingDate > snapshotPeriod.endDate
//                                           AND accountingDate <= requestedAsOfDate
// (Correction 4: use accountingDate, not snapshot.generatedAt, as the cutoff.)
model PeriodAccountBalance {
  id                 String         @id @default(cuid())
  organizationId     String         @map("organization_id")
  fiscalYearId       String         @map("fiscal_year_id")
  accountingPeriodId String         @map("accounting_period_id")
  accountId          String         @map("account_id")
  projectId          String?        @map("project_id")
  departmentId       String?        @map("department_id")
  costCenterId       String?        @map("cost_center_id")
  openingDebit       Decimal        @default(0) @map("opening_debit") @db.Decimal(18, 2)
  openingCredit      Decimal        @default(0) @map("opening_credit") @db.Decimal(18, 2)
  periodDebit        Decimal        @default(0) @map("period_debit") @db.Decimal(18, 2)
  periodCredit       Decimal        @default(0) @map("period_credit") @db.Decimal(18, 2)
  closingDebit       Decimal        @default(0) @map("closing_debit") @db.Decimal(18, 2)
  closingCredit      Decimal        @default(0) @map("closing_credit") @db.Decimal(18, 2)
  baseCurrency       String         @map("base_currency") @db.VarChar(3)
  snapshotVersion    Int            @default(1) @map("snapshot_version")
  generatedAt        DateTime       @map("generated_at")
  generatedBy        String         @map("generated_by")
  status             SnapshotStatus @default(VALID)

  accountingPeriod AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])

  @@index([organizationId, accountingPeriodId, accountId])
  @@index([accountingPeriodId, status])
  @@map("period_account_balances")
}

// Control-account reconciliation compares CLOSING GL balance as of period end
// against subledger closing balance (Correction 5):
//   AR GL closing balance = opening AR + all AR debits - all AR credits through period end
//   Compare to: ∑ outstanding ClientInvoice amounts as of period end
//   Variance must be $0.00 to pass period-close gate.
model SubledgerControlReconciliation {
  id                 String               @id @default(cuid())
  organizationId     String               @map("organization_id")
  accountId          String               @map("account_id")
  accountingPeriodId String               @map("accounting_period_id")
  // GL closing balance as of period end (NOT period movement)
  glClosingBalance   Decimal              @map("gl_closing_balance") @db.Decimal(18, 2)
  // Sum of open subledger items as of period end
  subledgerBalance   Decimal              @map("subledger_balance") @db.Decimal(18, 2)
  variance           Decimal              @db.Decimal(18, 2)
  status             ReconciliationStatus @default(UNREVIEWED)
  reviewedBy         String?              @map("reviewed_by")
  reviewedAt         DateTime?            @map("reviewed_at")
  notes              String?
  computedAt         DateTime             @default(now()) @map("computed_at")

  @@index([organizationId, accountingPeriodId])
  @@map("subledger_control_reconciliations")
}

// ─── Operational Tracking ─────────────────────────────────────────────────────

// PostingAttempt is written in a SEPARATE small transaction AFTER the main transaction
// rolls back. This ensures failure evidence is persisted even when the main tx fails.
// Never write PostingAttempt inside the main posting transaction.
model PostingAttempt {
  id                   String         @id @default(cuid())
  organizationId       String         @map("organization_id")
  sourceDocumentType   SourceDocType  @map("source_document_type")
  sourceDocumentId     String         @map("source_document_id")
  sourceRevision       Int            @map("source_revision")
  attemptedBy          String         @map("attempted_by")
  attemptedAt          DateTime       @map("attempted_at")
  outcome              AttemptOutcome
  errorCode            String?        @map("error_code")
  errorMessage         String?        @map("error_message")
  postingRuleVersionId String?        @map("posting_rule_version_id")
  journalEntryId       String?        @map("journal_entry_id")
  correlationId        String         @map("correlation_id")

  @@index([organizationId, sourceDocumentType, sourceDocumentId])
  @@index([correlationId])
  @@map("posting_attempts")
}

// ─── Migration ────────────────────────────────────────────────────────────────

model AccountingMigrationBatch {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  startedAt      DateTime        @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  performedBy    String          @map("performed_by")
  approvedBy     String?         @map("approved_by")
  status         MigrationStatus @default(PENDING)
  checksum       String
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("accounting_migration_batches")
}

// R-06: PaymentReceipts from Sprint 3 that cannot be auto-assigned to a bank account
// are placed in this exception queue for Finance to resolve manually.
model PaymentReceiptMigrationException {
  id                    String          @id @default(cuid())
  organizationId        String          @map("organization_id")
  paymentReceiptId      String          @map("payment_receipt_id")
  reason                String
  status                ExceptionStatus @default(OPEN)
  resolvedBankAccountId String?         @map("resolved_bank_account_id")
  resolvedBy            String?         @map("resolved_by")
  resolvedAt            DateTime?       @map("resolved_at")
  notes                 String?
  createdAt             DateTime        @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("payment_receipt_migration_exceptions")
}

// ─── Accounting Configuration — 7 Separate Policy Aggregates ─────────────────
// Each policy is independently updatable by Finance.
// All reads go through AccountingConfigurationService facade.
// organizationId @id means 1:1 with Organization — no separate id column.

// baseCurrencyCode is IMMUTABLE after the first JournalEntry is posted.
model MonetaryPolicy {
  organizationId        String   @id @map("organization_id")
  baseCurrencyCode      String   @map("base_currency_code") @db.VarChar(3)
  reportingCurrencyCode String   @map("reporting_currency_code") @db.VarChar(3)
  updatedBy             String   @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("monetary_policy")
}

model FiscalCalendarPolicy {
  organizationId       String   @id @map("organization_id")
  fiscalYearStartMonth Int      @map("fiscal_year_start_month")
  fiscalYearStartDay   Int      @map("fiscal_year_start_day")
  // ACCO: useAdjustmentPeriods = false (ACC-PER-001)
  useAdjustmentPeriods Boolean  @default(false) @map("use_adjustment_periods")
  updatedBy            String   @map("updated_by")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("fiscal_calendar_policy")
}

model TaxPolicy {
  organizationId         String   @id @map("organization_id")
  defaultOutputTaxCodeId String?  @map("default_output_tax_code_id")
  defaultInputTaxCodeId  String?  @map("default_input_tax_code_id")
  updatedBy              String   @map("updated_by")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("tax_policy")
}

model NumberingPolicy {
  organizationId String         @id @map("organization_id")
  numberingScope NumberingScope @default(CONTINUOUS) @map("numbering_scope")
  updatedBy      String         @map("updated_by")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@map("numbering_policy")
}

model PostingPolicy {
