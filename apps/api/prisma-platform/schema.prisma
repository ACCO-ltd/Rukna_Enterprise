generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  dbUrl     String       @map("db_url")
  status    TenantStatus @default(PROVISIONING)
  plan      String       @default("standard")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  outboundMessageRoutes OutboundMessageRoute[]

  @@map("tenants")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// ADR-042 phase 2 — which tenant sent a WhatsApp message. The public webhook (no tenant subdomain)
/// looks the provider message id up here to find the tenant DB that holds the OutboundMessage.
model OutboundMessageRoute {
  providerMessageId String   @id @map("provider_message_id")
  tenantId          String   @map("tenant_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("outbound_message_routes")
}
