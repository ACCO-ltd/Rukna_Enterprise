# ─────────────────────────────────────────────────────────────────────────────
# Rukna API — PRODUCTION environment (Contabo VPS, single-tenant: ACCO)
#
# Copy to `.env` on the server (or inject via docker-compose `env_file`) and fill
# every <PLACEHOLDER>. Never commit the filled file. Generate secrets with:
#     openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# Browser origin(s) allowed to call the API with credentials. Comma-separated.
# The web app on Vercel. Add Vercel preview URLs here too if you use them.
FRONTEND_URL=https://app.rukna.site

# ── Cookies (cross-subdomain auth) ───────────────────────────────────────────
# The refresh cookie is set by api.rukna.site and read back by it. app.rukna.site
# and api.rukna.site are the same registrable domain (rukna.site), so SameSite=Lax
# is sent on the web→api call. Domain is set explicitly for clarity + future tenants.
COOKIE_DOMAIN=.rukna.site
COOKIE_SAMESITE=lax

# ── Databases (PostgreSQL on this VPS) ───────────────────────────────────────
# Platform registry — holds the tenant list (which DB each tenant uses).
PLATFORM_DATABASE_URL=postgresql://erp_user:<DB_PASSWORD>@postgres:5432/rukna_platform
# Tenant DB — used only by the migration runner; at runtime each tenant's URL is
# read from the platform registry. For single-tenant this is the ACCO DB.
DATABASE_URL=postgresql://erp_user:<DB_PASSWORD>@postgres:5432/rukna_acco

# ── Tenancy (single-tenant mode) ─────────────────────────────────────────────
# Any request that carries no resolvable tenant subdomain falls back to this slug.
# api.rukna.site → "api" is reserved → falls back to acco. This is the whole
# single-tenant switch.
DEFAULT_TENANT_SLUG=acco
# Leave TENANT_ROOT_DOMAIN unset in single-tenant mode.
# TENANT_ROOT_DOMAIN=rukna.site

# ── JWT (MUST be 32+ chars each; use DIFFERENT values) ───────────────────────
JWT_ACCESS_SECRET=<openssl rand -base64 48>
JWT_REFRESH_SECRET=<openssl rand -base64 48>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── File storage (MinIO on this VPS, exposed at storage.rukna.site) ──────────
FILE_STORAGE_BUCKET=rukna-files
# Public endpoint the BROWSER uses for presigned upload/download — must be HTTPS
# and reachable from the internet (Caddy proxies it to the MinIO container).
MINIO_ENDPOINT=https://storage.rukna.site
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>
