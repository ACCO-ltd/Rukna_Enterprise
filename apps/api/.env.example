# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://acco.localhost:3000

# ── Platform Database ─────────────────────────────────────────────────────────
# Tenant registry — one shared DB for the entire platform.
PLATFORM_DATABASE_URL=postgresql://erp_user:erp_password@localhost:5435/rukna_platform

# ── Tenant Database ───────────────────────────────────────────────────────────
# Used ONLY for migrations (prisma migrate dev/deploy).
# At runtime, each tenant's DB URL is read from the platform DB tenants table.
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5435/rukna_acco

# ── JWT ───────────────────────────────────────────────────────────────────────
# Change both secrets in staging and production (min 32 characters).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── WhatsApp Cloud API (ADR-042) ──────────────────────────────────────────────
# Secrets: set real values only in the server's apps/api/.env — never commit them.
# Verify token: any long random string you choose; enter the SAME value in Meta →
#   WhatsApp → Configuration → Webhook → "Verify token".
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret: Meta app → App settings → Basic → "App secret" (signs every webhook call).
WHATSAPP_APP_SECRET=
# Sending (used by "send invoice by WhatsApp"): a PERMANENT System User token, not the
# 24-hour test token from the API Setup page.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Graph API version used by the sending client (default v21.0 when empty).
WHATSAPP_GRAPH_VERSION=
# Names of the Meta-APPROVED message templates (texts: docs/integrations/whatsapp-templates.md).
# Leave one empty until Meta approves it; that kind of message then cannot be sent.
WHATSAPP_TEMPLATE_INVOICE=
WHATSAPP_TEMPLATE_RECEIPT=
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=
WHATSAPP_TEMPLATE_OVERDUE_REMINDER=
# Language code the templates were approved in (default en).
WHATSAPP_TEMPLATE_LANGUAGE=
# Graph API version used by the sending client (default v21.0 when empty).
WHATSAPP_GRAPH_VERSION=
# Names of the Meta-APPROVED message templates (texts: docs/integrations/whatsapp-templates.md).
# Leave empty until Meta approves each one; that purpose then cannot be sent.
WHATSAPP_TEMPLATE_INVOICE=
WHATSAPP_TEMPLATE_RECEIPT=
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=
WHATSAPP_TEMPLATE_OVERDUE_REMINDER=
# Language code the templates were approved in (default en).
WHATSAPP_TEMPLATE_LANGUAGE=

# ── Quotation WhatsApp alerts to staff (ADR-044 phase 2) ──────────────────────
# Kill switch: alerts are queued (and the 2 h / 4 h SLA chaser runs) only when exactly "true".
QUOTATION_WHATSAPP_ENABLED=false
# Template names — empty = the defaults quote_ready_so, quote_reminder_so, quote_escalation_so,
# quote_chosen_so, quote_another_so (texts: docs/integrations/whatsapp-templates.md §5–9).
WHATSAPP_TEMPLATE_QUOTE_READY=
WHATSAPP_TEMPLATE_QUOTE_REMINDER=
WHATSAPP_TEMPLATE_QUOTE_ESCALATION=
WHATSAPP_TEMPLATE_QUOTE_CHOSEN=
WHATSAPP_TEMPLATE_QUOTE_ANOTHER=
# Language the Somali staff templates were registered under in Meta (default en).
WHATSAPP_TEMPLATE_QUOTE_LANGUAGE=
