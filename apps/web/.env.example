# ── API ───────────────────────────────────────────────────────────────────────
# The API is tenant-scoped by subdomain. The frontend derives the tenant slug from the
# browser host and substitutes it into this template, so a single deployment serves every
# tenant. See src/lib/tenant.ts.
#
# Local development:  http://acco.localhost:3000  →  http://acco.localhost:3001/api/v1
# Production:         https://acco.rukna.app      →  https://acco.rukna.app/api/v1
NEXT_PUBLIC_API_URL_TEMPLATE=http://{slug}.localhost:3001/api/v1

# Fallback used when the host carries no tenant subdomain — server-side rendering, tests,
# and any non-browser context.
#
# NOTE: a bare `localhost` host has no subdomain, so the API's TenancyMiddleware cannot
# resolve a tenant and answers 404 Tenant not found. Develop against
# http://acco.localhost:3000, never http://localhost:3000.
NEXT_PUBLIC_API_URL=http://acco.localhost:3001/api/v1
