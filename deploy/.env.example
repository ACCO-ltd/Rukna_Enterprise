# ─────────────────────────────────────────────────────────────────────────────
# Compose-level secrets for deploy/docker-compose.prod.yml
# Copy to `deploy/.env` on the server and fill in. Do NOT commit the filled file.
#
# These interpolate into the compose file (postgres/minio). The DB_PASSWORD here
# MUST equal the password embedded in PLATFORM_DATABASE_URL / DATABASE_URL inside
# apps/api/.env, and the MinIO keys MUST equal MINIO_ACCESS_KEY / MINIO_SECRET_KEY
# there.
# ─────────────────────────────────────────────────────────────────────────────

DB_PASSWORD=<strong-db-password>

MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key-min-8-chars>
FILE_STORAGE_BUCKET=rukna-files
