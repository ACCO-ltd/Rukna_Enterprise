# ─────────────────────────────────────────────────────────────────────────────
# Rukna — site blocks to APPEND to the shared Caddy on this box.
#
# This box already runs a shared Caddy (deploy-caddy-1) whose config lives at
# /opt/simad/deploy/Caddyfile and which fronts the other products. Rukna does NOT
# run its own Caddy — instead these two blocks are appended to that shared file,
# then Caddy is reloaded:
#
#   cat deploy/Caddyfile >> /opt/simad/deploy/Caddyfile
#   docker exec deploy-caddy-1 caddy reload --config /etc/caddy/Caddyfile
#
# Reaches Rukna's containers by name because api + minio join the deploy_internal
# network (see docker-compose.prod.yml) — exactly how tconnect-* is wired. Caddy
# auto-provisions Let's Encrypt certs for both hosts (DNS must point here, DNS-only).
# ─────────────────────────────────────────────────────────────────────────────

api.rukna.site {
	encode zstd gzip
	request_body {
		max_size 512MB
	}
	reverse_proxy rukna_api:3001
}

storage.rukna.site {
	request_body {
		max_size 512MB
	}
	reverse_proxy rukna_minio:9000
}
