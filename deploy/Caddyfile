# ─────────────────────────────────────────────────────────────────────────────
# Rukna — the site block for the OPERATOR to add to the shared Caddy on this box.
#
# The agent does NOT edit Caddy. You add this block yourself. The box already runs
# a shared Caddy (deploy-caddy-1, config /opt/simad/deploy/Caddyfile) that owns
# 80/443; Rukna's api container attaches to its network (deploy_internal) so Caddy
# can reach it by name — exactly how tconnect-* is wired.
#
#   # back up first
#   cp /opt/simad/deploy/Caddyfile /opt/simad/deploy/Caddyfile.bak.$(date +%s)
#   # append this block
#   cat deploy/Caddyfile >> /opt/simad/deploy/Caddyfile   # (strip these comments if you prefer)
#   # validate, then reload (reload refuses an invalid config, so other sites stay up)
#   docker exec deploy-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec deploy-caddy-1 caddy reload   --config /etc/caddy/Caddyfile
#
# api.rukna.site (backend), acco.rukna.site (web) and storage.rukna.site (object
# storage) are here.
#
# storage.rukna.site was added in Phase 7 Step 2. It had been deliberately omitted, and
# that is what made every file upload and download fail in production: the presigned URL
# is followed by the BROWSER, not the API, so an unroutable storage host breaks the whole
# feature (Phase 7 audit P0-3).
#
# What is exposed is narrow: MinIO's S3 API port (9000) only. The console (9001) is on
# no proxied path. The bucket has no anonymous policy, so a URL without a valid signature
# gets AccessDenied — there are no public object URLs and no listing. Signatures last 15
# minutes and the API issues one only after authorizing the caller against the record that
# owns the file.
#
# DNS: api.rukna.site, acco.rukna.site and storage.rukna.site are A records → this VPS
# (DNS-only). Caddy terminates TLS for all three.
# ─────────────────────────────────────────────────────────────────────────────

api.rukna.site {
	encode zstd gzip
	request_body {
		max_size 512MB
	}
	reverse_proxy rukna_api:3001
}

acco.rukna.site {
	encode zstd gzip
	reverse_proxy rukna_web:3000
}

storage.rukna.site {
	encode zstd gzip
	# Object uploads. The API caps nothing at this layer — the signature does.
	request_body {
		max_size 512MB
	}
	# MinIO's S3 API. NOT :9001, which is the admin console and must never be proxied.
	reverse_proxy rukna_minio:9000
}
