# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://acco.localhost:3000

# Platform Database (tenant registry — one DB for the entire platform)
PLATFORM_DATABASE_URL=postgresql://erp_user:erp_password@localhost:5435/rukna_platform

# Tenant Database URL (used only for migrations: prisma migrate dev/deploy)
# At runtime, tenant DB URLs are read from the tenants table in the platform DB
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5435/rukna_acco

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
